<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>../../OhMyLockScreen/OhMyLockScreen_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <ProjectReference Include="../../OhMyLockScreen.Shared/OhMyLockScreen.Shared.csproj" />
    <ProjectReference Include="../../OhMyLockScreen.AudioHost/OhMyLockScreen.AudioHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Content Include="../../OhMyLockScreen.AudioHost/bin/$(Platform)/$(Configuration)/net10.0-windows10.0.26100.0/win-$(Platform)/OhMyLockScreen.AudioHost.exe" Link="OhMyLockScreen.AudioHost.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../OhMyLockScreen.AudioHost/bin/$(Platform)/$(Configuration)/net10.0-windows10.0.26100.0/win-$(Platform)/OhMyLockScreen.AudioHost.dll" Link="OhMyLockScreen.AudioHost.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../OhMyLockScreen.AudioHost/bin/$(Platform)/$(Configuration)/net10.0-windows10.0.26100.0/win-$(Platform)/OhMyLockScreen.AudioHost.deps.json" Link="OhMyLockScreen.AudioHost.deps.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../OhMyLockScreen.AudioHost/bin/$(Platform)/$(Configuration)/net10.0-windows10.0.26100.0/win-$(Platform)/OhMyLockScreen.AudioHost.runtimeconfig.json" Link="OhMyLockScreen.AudioHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../OhMyLockScreen/Assets/*.png" Link="Assets/%(Filename)%(Extension)" />
    <Compile Include="../../OhMyLockScreen/Models/Features/**/*.cs" Link="Models/Features/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../OhMyLockScreen/Services/Features/Appearance/BorderFeature.cs" Link="Services/BorderFeature.cs" />

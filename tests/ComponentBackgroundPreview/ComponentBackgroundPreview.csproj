    <Compile Include="../../OhMyLockScreen/Services/Features/Layout/LayoutFeature.cs" Link="Services/LayoutFeature.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Features/Layout/GridLayoutFeature.cs" Link="Services/GridLayoutFeature.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Scene/SceneLayoutEditing.cs" Link="Services/SceneLayoutEditing.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Scene/SceneBlobStorageService.cs" Link="Services/SceneBlobStorageService.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Scene/SceneService.cs" Link="Services/SceneService.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Scene/DefaultSceneFactory.cs" Link="Services/DefaultSceneFactory.cs" />
    <Compile Include="../../OhMyLockScreen/Services/SettingsService.cs" Link="Services/SettingsService.cs" />
    <Compile Include="../../OhMyLockScreen/Models/Settings.cs" Link="Models/Settings.cs" />
    <Compile Include="../../OhMyLockScreen/Services/FontCatalogService.cs" Link="Services/FontCatalogService.cs" />
    <Compile Include="../../OhMyLockScreen/Services/FeatureHost/FeatureService.cs" Link="Services/FeatureService.cs" />
    <Compile Include="../../OhMyLockScreen/Services/Scene/ComponentsService.cs" Link="Services/ComponentsService.cs" />
    <Compile Include="../../OhMyLockScreen/Models/Scene/*.cs" Link="Models/Scene/%(Filename)%(Extension)" />
    <Compile Include="../../OhMyLockScreen/Controls/Components/*Component.xaml.cs" Link="Controls/Components/%(Filename)%(Extension)" />
    <Compile Include="../../OhMyLockScreen/Controls/Components/ComponentViewBases.cs" Link="Controls/Components/ComponentViewBases.cs" />
    <Compile Include="../../OhMyLockScreen/Controls/Components/TextDefaultFeaturesProviders.cs" Link="Controls/Components/TextDefaultFeaturesProviders.cs" />
    <Compile Include="../../OhMyLockScreen/Controls/Components/Media*.cs" Link="Controls/Components/%(Filename)%(Extension)" />

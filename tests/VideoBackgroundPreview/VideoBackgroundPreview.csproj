<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>../../OhMyLockScreen/OhMyLockScreen_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.UWP" Version="3.10.2" />
    <PackageReference Include="LibVLC.UWP" Version="3.0.23-2608082208" />
    <Compile Include="../../OhMyLockScreen.Shared/Controls/Scene/BackgroundVideoView.cs" Link="BackgroundVideoView.cs" />
    <Compile Include="../../OhMyLockScreen.Shared/Controls/Scene/VideoSwapChain.cs" Link="VideoSwapChain.cs" />
    <Content Include="../../OhMyLockScreen/Assets/*.png" Link="Assets/%(Filename)%(Extension)" />
    <Content Include="../../OhMyLockScreen/Assets/Videos/testbg.mp4" Link="TestVideo.mp4" />
  </ItemGroup>
</Project>

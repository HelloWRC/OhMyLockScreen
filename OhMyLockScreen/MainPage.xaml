<Page
    x:Class="OhMyLockScreen.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Foreground="White"
    SizeChanged="OnSizeChanged">

    <Grid Background="Transparent">
        <Border x:Name="BackgroundPlaceholder" Background="#17324D">
            <MediaElement
                Source="ms-appx:///Assets/Videos/testbg.mp4"
                AutoPlay="True"
                IsLooping="True"
                IsMuted="True"
                AreTransportControlsEnabled="False"
                IsHitTestVisible="False"
                Stretch="UniformToFill" />
        </Border>

        <Grid IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ForegroundTranslation" />
            </Grid.RenderTransform>

            <Viewbox
                x:Name="ClockViewbox"
                Margin="32,0,32,96"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Stretch="Uniform"
                StretchDirection="DownOnly">
                <StackPanel>
                    <TextBlock
                        x:Name="TimeText"
                        FontFamily="Segoe UI"
                        FontSize="96"
                        FontWeight="Light"
                        IsTextSelectionEnabled="False" />
                    <TextBlock
                        x:Name="DateText"
                        FontFamily="Segoe UI, Microsoft YaHei UI"
                        FontSize="42"
                        IsTextSelectionEnabled="False" />
                </StackPanel>
            </Viewbox>

            <FontIcon
                Margin="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontFamily="Segoe MDL2 Assets"
                FontSize="20"
                Glyph="&#xE839;"
                AutomationProperties.Name="网络状态（占位）" />
        </Grid>

        <StackPanel
            MaxWidth="720"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
            <Border Padding="20,12" Background="#E6101418" CornerRadius="8">
                <TextBlock
                    x:Name="ActivationKindText"
                    Text="App.OnActivated args.Kind：尚未触发"
                    FontSize="18"
                    Foreground="White"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </Border>

            <Border
                x:Name="DismissStatusPanel"
                Margin="0,8,0,0"
                Padding="20,12"
                Background="#E6101418"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="DismissStatusText"
                    FontSize="18"
                    Foreground="White"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </Border>
        </StackPanel>
    </Grid>
</Page>

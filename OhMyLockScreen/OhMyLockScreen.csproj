<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>false</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>OhMyLockScreen_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Uwp.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="LibVLC.UWP" Version="3.0.23-2608082208" />
    <ProjectReference Include="..\OhMyLockScreen.Shared\OhMyLockScreen.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Models\Scene\" />
  </ItemGroup>
  <Target Name="WriteAppxManifestVersionInput" DependsOnTargets="ResolveGitBuildVersion">
    <PropertyGroup>
      <_AppxManifestVersionInput>$(IntermediateOutputPath)PackageVersion.txt</_AppxManifestVersionInput>
      <_VersionedAppxManifest>$(IntermediateOutputPath)Package.appxmanifest</_VersionedAppxManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(_AppxManifestVersionInput)" Lines="$(GitBuildVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="GenerateVersionedAppxManifest" DependsOnTargets="WriteAppxManifestVersionInput" Inputs="$(MSBuildAllProjects);@(AppxManifest);$(_AppxManifestVersionInput)" Outputs="$(_VersionedAppxManifest)">
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_VersionedAppxManifest)" />
    <XmlPoke XmlInputPath="$(_VersionedAppxManifest)" Query="/appx:Package/appx:Identity/@Version" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" Value="$(GitBuildVersion)" />
  </Target>
  <Target Name="UseVersionedAppxManifest" BeforeTargets="_ValidatePresenceOfAppxManifestItems;BeforeGenerateAppxManifest" DependsOnTargets="GenerateVersionedAppxManifest" Condition="'$(DesignTimeBuild)' != 'true' And '@(AppxManifest)' != ''">
    <ItemGroup>
      <_VersionedAppxManifestItem Include="@(AppxManifest->'$(_VersionedAppxManifest)')" />
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="@(_VersionedAppxManifestItem)" />
      <FileWrites Include="$(_AppxManifestVersionInput);$(_VersionedAppxManifest)" />
    </ItemGroup>
  </Target>
  <Import Project="..\OhMyLockScreen.NativeHost\PackageNativeHost.targets" />
</Project>

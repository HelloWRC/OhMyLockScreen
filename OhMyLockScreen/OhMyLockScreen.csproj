<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>false</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>OhMyLockScreen_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AudioHostOutput>$(MSBuildProjectDirectory)\..\OhMyLockScreen.AudioHost\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\win-$(Platform)</AudioHostOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="LibVLC.UWP" Version="3.0.23-2608082208" />
    <ProjectReference Include="..\OhMyLockScreen.Shared\OhMyLockScreen.Shared.csproj" />
    <ProjectReference Include="..\OhMyLockScreen.AudioHost\OhMyLockScreen.AudioHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The helper shares this package's self-contained runtime and existing dependencies. -->
    <Content Include="$(AudioHostOutput)\OhMyLockScreen.AudioHost.exe" Link="OhMyLockScreen.AudioHost.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(AudioHostOutput)\OhMyLockScreen.AudioHost.dll" Link="OhMyLockScreen.AudioHost.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(AudioHostOutput)\OhMyLockScreen.AudioHost.deps.json" Link="OhMyLockScreen.AudioHost.deps.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(AudioHostOutput)\OhMyLockScreen.AudioHost.runtimeconfig.json" Link="OhMyLockScreen.AudioHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Models\Scene\" />
  </ItemGroup>
</Project>

<Page
    x:Class="OhMyLockScreen.Views.ApplicationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Uwp"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <x:Double x:Key="SettingsNavigationPaneWidth">320</x:Double>
        <Thickness x:Key="SettingsExpandedTitleMargin">56,44,56,0</Thickness>
        <Thickness x:Key="SettingsCompactTitleMargin">16,24,16,0</Thickness>

        <Style x:Key="SettingsTitleAreaStyle" TargetType="Grid">
            <Setter Property="MaxWidth" Value="{StaticResource SettingsContainerWidth}" />
        </Style>
        <Style x:Key="SettingsNavigationIconStyle" TargetType="icons:FluentIcon">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Page.Resources>
    <muxc:NavigationView
        x:Name="SettingsNavigation"
        AlwaysShowHeader="False"
        ExpandedModeThresholdWidth="{StaticResource SettingsExpandedModeThresholdWidth}"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="{StaticResource SettingsNavigationPaneWidth}"
        PaneDisplayMode="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleArea"
                Style="{StaticResource SettingsTitleAreaStyle}">
                <TextBlock
                    x:Name="SettingsTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
            </Grid>
            <Frame
                x:Name="SettingsFrame"
                Grid.Row="1"
                CacheSize="0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SlideNavigationTransitionInfo Effect="FromBottom" />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>
    </muxc:NavigationView>
</Page>

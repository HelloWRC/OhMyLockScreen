<Page
    x:Class="OhMyLockScreen.Views.SceneManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:icons="using:FluentIcons.Uwp"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    xmlns:vm="using:OhMyLockScreen.ViewModels"
    xmlns:manager="using:OhMyLockScreen.Controls.SceneManager"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
    FontFamily="Microsoft YaHei UI">
    <Page.Resources>
        <DataTemplate x:Key="RevealExportedFileButtonTemplate">
            <Button
                Content="在文件资源管理器中显示"
                Click="OnRevealExportedFileClick" />
        </DataTemplate>
    </Page.Resources>
    <Grid
        x:Name="PageRoot"
        Background="{ThemeResource SystemControlTransparentBrush}"
        AllowDrop="True"
        DragOver="OnPageDragOver"
        Drop="OnPageDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentDialog
            x:Name="NameDialog"
            Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
            PrimaryButtonText="确定"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonClick="OnNameDialogPrimaryButtonClick">
            <TextBox
                Text="{x:Bind ViewModel.DialogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Header="{x:Bind ViewModel.DialogNameError, Mode=OneWay}"
                MaxLength="120"
                MinWidth="280" />
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteSceneDialog"
            Title="删除场景？"
            PrimaryButtonText="删除"
            CloseButtonText="取消"
            DefaultButton="Close"
            Content="{x:Bind ViewModel.DialogMessage, Mode=OneWay}" />

        <ContentDialog
            x:Name="ImportSceneDialog"
            Title="导入场景？"
            PrimaryButtonText="导入"
            CloseButtonText="取消"
            DefaultButton="Primary">
            <StackPanel Spacing="8" MaxWidth="420">
                <TextBlock
                    Text="{x:Bind ViewModel.DialogMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.DialogDetail, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    MaxLines="6"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.HasDialogDetail, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
            </StackPanel>
        </ContentDialog>

        <!-- 顶部导航栏：左侧复用 Pivot，中间为筛选框，右侧为操作与辅助入口按钮 -->
        <Grid
            Padding="4,0,4,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="76" />
                <ColumnDefinition Width="2*" MaxWidth="512" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Pivot
                x:Name="LibraryNavigation"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Height="48"
                SelectedIndex="0"
                IsHeaderItemsCarouselEnabled="False">
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <icons:FluentIcon
                                Icon="Library"
                                FontSize="16" />
                            <TextBlock
                                Text="库"
                                FontSize="14" />
                        </StackPanel>
                    </PivotItem.Header>
                </PivotItem>
            </Pivot>

            <Grid
                Grid.Column="1"
                Height="32"
                MaxWidth="512"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <TextBox
                    x:Name="FilterBox"
                    Height="32"
                    Padding="34,5,10,5"
                    PlaceholderText="筛选…"
                    AutomationProperties.Name="筛选场景"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <icons:FluentIcon
                    Icon="Search"
                    FontSize="14"
                    Margin="11,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False" />
            </Grid>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="64"
                    Height="32"
                    ToolTipService.ToolTip="预览当前启用的场景"
                    AutomationProperties.Name="预览当前启用的场景"
                    Click="OnPreviewActiveSceneClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:FluentIcon Icon="Play" FontSize="20" />
                        <TextBlock Text="预览" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="新建场景…"
                    AutomationProperties.Name="新建场景"
                    Click="OnCreateSceneClick">
                    <icons:FluentIcon
                        Icon="Add"
                        FontSize="16" />
                </Button>
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="导入场景…"
                    AutomationProperties.Name="导入场景"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                    Click="OnImportSceneClick">
                    <icons:FluentIcon
                        Icon="ArrowImport"
                        FontSize="16" />
                </Button>
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="打开场景文件夹…"
                    AutomationProperties.Name="打开场景文件夹"
                    Click="OnOpenScenesFolderClick">
                    <icons:FluentIcon
                        Icon="FolderOpen"
                        FontSize="16" />
                </Button>
                <Rectangle
                    Width="1"
                    Height="32"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="支持开发者…"
                    AutomationProperties.Name="支持开发者"
                    Click="OnSponsorClick">
                    <icons:FluentIcon
                        Icon="Heart"
                        FontSize="16" />
                </Button>
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="问题反馈…"
                    AutomationProperties.Name="问题反馈"
                    Click="OnFeedbackClick">
                    <icons:FluentIcon
                        Icon="PersonFeedback"
                        FontSize="16" />
                </Button>
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="应用设置"
                    AutomationProperties.Name="应用设置"
                    Click="OnSettingsClick">
                    <icons:FluentIcon
                        Icon="Settings"
                        FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BackgroundSizing="OuterBorderEdge"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            IsHitTestVisible="False" />

        <muxc:InfoBar
            x:Name="LockScreenReplacementInfoBar"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsOpen="False"
            Severity="Warning"
            Title="未启用替换系统锁屏"
            Message="请按指南将 OhMyLockScreen 设为锁屏提供方，以应用当前锁屏场景。">
            <muxc:InfoBar.ActionButton>
                <HyperlinkButton
                    Content="查看启用指南"
                    NavigateUri="https://github.com/HelloWRC/OhMyLockScreen/blob/master/docs/activating-lockscreen.md" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <Grid Grid.Row="2">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <muxc:ItemsRepeater
                    x:Name="ScenesRepeater"
                    Margin="10,10,10,16"
                    ItemsSource="{x:Bind ViewModel.FilteredScenes}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:UniformGridLayout
                            MinItemWidth="356"
                            MinItemHeight="200"
                            MinColumnSpacing="16"
                            MinRowSpacing="16"
                            ItemsJustification="Start"
                            ItemsStretch="None" />
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneCardItem">
                            <manager:ScenePreviewCard
                                Item="{x:Bind}"
                                Activated="OnCardActivated"
                                EditRequested="OnCardEditRequested"
                                PreviewRequested="OnCardPreviewRequested"
                                ExportRequested="OnCardExportRequested"
                                DuplicateRequested="OnCardDuplicateRequested"
                                OpenFolderRequested="OnCardOpenFolderRequested"
                                RenameRequested="OnCardRenameRequested"
                                DeleteRequested="OnCardDeleteRequested" />
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
            </ScrollViewer>

            <ui:Empty
                Text="没有找到匹配的场景"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
        </Grid>

        <!-- 底部状态栏：左侧显示场景数量，右侧显示完整版本号 -->
        <Grid
            Grid.Row="3"
            MinHeight="27"
            Padding="8,4,8,5"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{x:Bind ViewModel.SceneCountText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.Name="场景数量" />

            <TextBlock
                Grid.Column="1"
                Text="{x:Bind DisplayVersion}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="应用版本" />
        </Grid>
    </Grid>
</Page>

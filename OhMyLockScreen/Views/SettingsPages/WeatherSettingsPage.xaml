<settings:SettingsPageBase
    x:Class="OhMyLockScreen.Views.SettingsPages.WeatherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:OhMyLockScreen.Shared.Abstractions.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    xmlns:weatherModels="using:OhMyLockScreen.Shared.Models.Weather">
    <settings:SettingsPageBase.Resources>
        <Style x:Key="WeatherSection" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="WeatherMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="WeatherChoice" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Height="28" Padding="8,0" CornerRadius="14" Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chip.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="Chip.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="ChipLabel.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="Chip.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="ChipLabel.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock x:Name="ChipLabel" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </settings:SettingsPageBase.Resources>

    <Grid>
        <ScrollViewer HorizontalContentAlignment="Stretch">
            <Grid>
                <StackPanel Style="{StaticResource SettingsStackPanelStyle}">
                <StackPanel Style="{StaticResource WeatherSection}">
                    <ContentControl x:Name="PreviewSectionIcon" />
                    <TextBlock Text="天气预览" />
                </StackPanel>
                <Border Padding="20" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ContentControl x:Name="PreviewIcon" MinWidth="52" MaxWidth="120" Height="52" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="32" FontWeight="SemiBold"><Run x:Name="TemperatureValue" /><Run x:Name="TemperatureUnit" FontSize="18" /></TextBlock>
                                    <TextBlock x:Name="PreviewUpdated" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PreviewMetrics" Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="湿度" Style="{StaticResource WeatherMetricLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <ContentControl x:Name="PreviewHumidityIcon" VerticalAlignment="Center" />
                                        <TextBlock FontWeight="Medium" VerticalAlignment="Center"><Run x:Name="HumidityValue" /><Run x:Name="HumidityUnit" FontSize="10" /></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="空气质量" Style="{StaticResource WeatherMetricLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <ContentControl x:Name="PreviewAirIcon" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewAir" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="风力" Style="{StaticResource WeatherMetricLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <ContentControl x:Name="PreviewWindIcon" VerticalAlignment="Center" />
                                        <TextBlock FontWeight="Medium" VerticalAlignment="Center"><Run x:Name="WindValue" /><Run x:Name="WindUnit" FontSize="10" /></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center" Width="40" Height="40">
                                <Button x:Name="RefreshButton" Width="40" Height="40" Padding="8,4" Style="{StaticResource TransparentButton}" Click="OnRefresh" AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新" />
                                <muxc:ProgressRing x:Name="RefreshProgress" Width="40" Height="40" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="PreviewAlerts" Spacing="4" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,4" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Style="{StaticResource WeatherSection}">
                    <ContentControl x:Name="LocationSectionIcon" />
                    <TextBlock Text="位置设置" />
                </StackPanel>
                <toolkit:SettingsExpander x:Name="LocationExpander" Header="天气位置" Description="设置 OhMyLockScreen 用于查询天气的位置信息及获取方式。" IsExpanded="True">
                    <toolkit:SettingsExpander.Content>
                        <ListBox x:Name="LocationMode" SelectionChanged="OnLocationModeChanged" ItemContainerStyle="{StaticResource WeatherChoice}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="天气位置">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBoxItem Content="选择城市" />
                            <ListBoxItem Content="坐标定位" />
                        </ListBox>
                    </toolkit:SettingsExpander.Content>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="CityPanel" Header="城市选择" Description="选择当前所在的城市，以用于天气查询。">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SelectedCity" VerticalAlignment="Center" />
                                <Button x:Name="EditCityButton" Margin="6,0,0,0" Padding="8,4" Style="{StaticResource TransparentButton}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="OnEditCity" AutomationProperties.Name="编辑城市" ToolTipService.ToolTip="编辑城市" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="CoordinatePanel" Header="位置坐标" Description="输入用于获取天气信息的经纬坐标。" Visibility="Collapsed">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Grid>
                                        <StackPanel x:Name="CoordinateFields" Orientation="Horizontal" Spacing="4" Padding="4,2">
                                            <TextBlock Text="经度" VerticalAlignment="Center" />
                                            <TextBox x:Name="Longitude" MinWidth="75" AutomationProperties.Name="经度" LostFocus="OnCoordinatesLostFocus" KeyDown="OnCoordinateKeyDown" />
                                            <TextBlock Text="°" VerticalAlignment="Center" />
                                            <TextBlock Text="纬度" VerticalAlignment="Center" />
                                            <TextBox x:Name="Latitude" MinWidth="75" AutomationProperties.Name="纬度" LostFocus="OnCoordinatesLostFocus" KeyDown="OnCoordinateKeyDown" />
                                            <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        </StackPanel>
                                        <Border x:Name="CoordinateBlurOverlay" CornerRadius="4">
                                            <Border.Background>
                                                <ui:BackdropBlurBrush BlurAmount="8" FallbackColor="{ThemeResource SolidBackgroundFillColorSecondary}" />
                                            </Border.Background>
                                        </Border>
                                        <Button x:Name="RevealCoordinates" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,4" Style="{StaticResource TransparentButton}" Click="OnRevealCoordinates" />
                                    </Grid>
                                    <Button x:Name="LocateButton" VerticalAlignment="Center" Padding="8,4" Style="{StaticResource TransparentButton}" Click="OnLocate" AutomationProperties.Name="自动定位" ToolTipService.ToolTip="自动定位" />
                                </StackPanel>
                                <TextBlock x:Name="CoordinateCity" FontSize="11" Margin="4,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CoordinateStatus" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="AutomaticPanel" Header="自动获取位置" Description="启用后，将在应用每次启动时自动更新位置信息。" Visibility="Collapsed">
                            <ToggleSwitch x:Name="AutomaticLocation" MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="自动获取位置" Toggled="OnAutomaticLocationChanged" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <Border Margin="0,12,0,4" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Style="{StaticResource WeatherSection}">
                    <ContentControl x:Name="AppearanceSectionIcon" />
                    <TextBlock Text="外观与高级设置" />
                </StackPanel>
                <toolkit:SettingsCard x:Name="IconStyleCard" Header="天气图标包" Description="调整在显示天气类型时使用的图标外观。">
                    <ComboBox x:Name="IconStyle" MinWidth="120" AutomationProperties.Name="天气图标包" SelectionChanged="OnIconStyleChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="weatherModels:WeatherIconTemplateRegistryInfo">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander x:Name="AlertExpander" Header="排除的气象预警" Description="包含以下字符串的预警将不会显示，一行一条排除项。">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="排除列表">
                            <TextBox x:Name="AlertExclusions" Width="260" Padding="8" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="排除列表" TextChanged="OnAlertExclusionsChanged" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <TextBlock Text="要调整场景上的天气信息显示，请在场景编辑器的【组件】页面中配置天气简报组件。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</settings:SettingsPageBase>

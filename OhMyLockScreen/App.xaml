<Application
    x:Class="OhMyLockScreen.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:OhMyLockScreen.Helpers.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary
                    Source="ms-appx:///Controls/Editor/EditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="SettingsContainerWidth">960</x:Double>
            <x:Double x:Key="SettingsExpandedModeThresholdWidth">1008</x:Double>
            <Thickness x:Key="SettingsExpandedContentMargin">56,12,56,16</Thickness>
            <Style x:Key="SettingsStackPanelStyle" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MaxWidth" Value="{StaticResource SettingsContainerWidth}" />
                <Setter Property="Margin" Value="16,12,16,16" />
                <Setter Property="Spacing" Value="6" />
                <Setter Property="ui:SettingsStackPanelLayout.UseAdaptiveMargin" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

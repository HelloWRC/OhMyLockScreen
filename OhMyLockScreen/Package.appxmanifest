<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap7 mp desktop rescap">

  <Identity
    Name="dev.hellowrc.OhMyLockScreen"
    Publisher="CN=HelloWRC.Dev"
    Version="1.0.4.2" />

  <mp:PhoneIdentity PhoneProductId="21d1ece6-1bdb-4081-a925-f210b751bd46" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>OhMyLockScreen</DisplayName>
    <PublisherDisplayName>HelloWRC.Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <!-- Keep the desktop entry first so it is also the default debugger target. -->
    <Application Id="Preview"
      Executable="$targetnametoken$.exe"
      EntryPoint="OhMyLockScreen.App">
      <uap:VisualElements
        DisplayName="OhMyLockScreen"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="OhMyLockScreen"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="OhMyLockScreen.AudioHost.exe">
          <desktop:FullTrustProcess>
            <desktop:ParameterGroup GroupId="AudioSpectrum" Parameters="--audio-spectrum" />
          </desktop:FullTrustProcess>
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- Preserve the existing lock-screen AUMID; this role is hosted by Windows. -->
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="OhMyLockScreen.App">
      <uap:VisualElements
        DisplayName="OhMyLockScreen"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="OhMyLockScreen"
        BackgroundColor="transparent"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.lockScreen"/>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="OhMyLockScreen.AudioHost.exe">
          <desktop:FullTrustProcess>
            <desktop:ParameterGroup GroupId="AudioSpectrum" Parameters="--audio-spectrum" />
          </desktop:FullTrustProcess>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <uap:Capability Name="picturesLibrary" />
    <uap7:Capability Name="globalMediaControl" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>

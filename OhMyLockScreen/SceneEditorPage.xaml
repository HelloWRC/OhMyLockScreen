<Page
    x:Class="OhMyLockScreen.SceneEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:scene="using:OhMyLockScreen.Shared.Controls.Scene"
    xmlns:vm="using:OhMyLockScreen.ViewModels"
    xmlns:components="using:OhMyLockScreen.Shared.Models.Scene"
    xmlns:editor="using:OhMyLockScreen.Controls.Editor"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    RequestedTheme="Dark"
    Background="#202020"
    Foreground="White"
    FontFamily="Microsoft YaHei UI">
    <Page.Resources>
        <DataTemplate x:Key="AddFeatureMenuItemTemplate">
            <MenuFlyoutItem Text="{Binding Name}" Click="OnAddFeatureClick" />
        </DataTemplate>
        <MenuFlyoutItem x:Key="NoAvailableFeaturesMenuItem" Text="没有可添加的特性" IsEnabled="False" />
        <DataTemplate
            x:Key="LayerInspectorTemplate">
            <editor:LayoutPanelSettingsControl
                Model="{Binding Model}" />
        </DataTemplate>
        <DataTemplate
            x:Key="RegisteredInspectorTemplate">
            <ContentControl
                Content="{Binding Editor}"
                HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <editor:InspectorEditorTemplateSelector
            x:Key="InspectorEditorTemplateSelector"
            LayerTemplate="{StaticResource LayerInspectorTemplate}"
            EditorTemplate="{StaticResource RegisteredInspectorTemplate}" />
        <MenuFlyout
            x:Key="TreeContextMenu">
            <MenuFlyoutItem
                Text="重命名"
                Click="OnRenameSelectionClick" />
            <MenuFlyoutItem
                Text="添加图层"
                Click="OnAddLayerClick" />
            <MenuFlyoutItem
                Text="上移"
                Click="OnMoveSelectionUpClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
            <MenuFlyoutItem
                Text="下移"
                Click="OnMoveSelectionDownClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
            <MenuFlyoutItem
                Text="删除"
                Click="OnDeleteSelectionClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
        </MenuFlyout>
        <Style
            x:Key="SectionPillStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="32" />
            <Setter
                Property="Height"
                Value="3" />
            <Setter
                Property="CornerRadius"
                Value="2" />
            <Setter
                Property="Background"
                Value="#60CDFF" />
            <Setter
                Property="HorizontalAlignment"
                Value="Left" />
        </Style>
        <Style
            x:Key="ResizeHandleStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="24" />
            <Setter
                Property="Height"
                Value="24" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
        </Style>
        <Style
            x:Key="FloatingPanelStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="325" />
            <Setter
                Property="CornerRadius"
                Value="7" />
            <Setter
                Property="BorderBrush"
                Value="#66757575" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="8" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
            <Setter
                Property="Background">
                <Setter.Value>
                    <AcrylicBrush
                        BackgroundSource="Backdrop"
                        TintColor="#202020"
                        TintOpacity="0.96"
                        FallbackColor="#ED202020" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid
        x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <ContentDialog
            x:Name="NameDialog"
            Title="{Binding DialogTitle, Mode=OneWay}"
            PrimaryButtonText="确定"
            CloseButtonText="取消"
            DefaultButton="Primary"
            RequestedTheme="Dark"
            PrimaryButtonClick="OnNameDialogPrimaryButtonClick">
            <TextBox
                Text="{Binding DialogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Header="{Binding DialogNameError, Mode=OneWay}"
                MaxLength="120"
                MinWidth="280" />
        </ContentDialog>
        <ContentDialog
            x:Name="DeleteSceneDialog"
            Title="删除场景？"
            PrimaryButtonText="删除"
            CloseButtonText="取消"
            DefaultButton="Close"
            RequestedTheme="Dark"
            Content="{Binding DialogMessage, Mode=OneWay}" />
        <Grid
            x:Name="TopNavigation"
            Padding="4,0,0,0"
            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="场景编辑器"
                FontWeight="Bold"
                Margin="12,0"
                VerticalAlignment="Center" />
            <Pivot
                x:Name="EditorNavigation"
                Grid.Column="1"
                SelectionChanged="OnNavigationChanged"
                SelectedIndex="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource EnumIndexConverter}}"
                HorizontalAlignment="Left"
                Height="48"
                IsHeaderItemsCarouselEnabled="False">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            FontSize="14" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem
                    Header="首页" />
                <PivotItem
                    Header="组件" />
                <PivotItem
                    Header="背景" />
            </Pivot>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="全屏预览（按任意键退出）"
                    AutomationProperties.Name="全屏预览"
                    Click="OnPreviewClick">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE768;"
                        FontSize="16" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="设置"
                    AutomationProperties.Name="设置"
                    Click="OnSettingsClick">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE713;"
                        FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            x:Name="MainContent"
            Grid.Row="{x:Bind ViewModel.ContentRow, Mode=OneWay}"
            Grid.RowSpan="{x:Bind ViewModel.ContentRowSpan, Mode=OneWay}"
            Background="Transparent"
            SizeChanged="OnContentSizeChanged">
            <Grid
                x:Name="SceneViewport"
                Background="Transparent"
                AllowDrop="True"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased"
                PointerCanceled="OnCanvasDragCanceled"
                PointerCaptureLost="OnCanvasDragCanceled"
                PointerExited="OnCanvasPointerExited"
                RightTapped="OnCanvasRightTapped"
                DragOver="OnCanvasDragOver"
                Drop="OnCanvasDrop">
                <scene:ScenePresenter
                    x:Name="EditorPresenter"
                    IsEditing="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                    IsHitTestVisible="{x:Bind ViewModel.IsPreview, Mode=OneWay}"
                    Scene="{x:Bind ViewModel.Scene, Mode=OneWay}" />
                <Canvas
                    IsHitTestVisible="False">
                    <Border
                        BorderBrush="#60CDFF"
                        BorderThickness="1"
                        Canvas.Left="{x:Bind ViewModel.HoverGeometry.X, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.HoverGeometry.Y, Mode=OneWay}"
                        Width="{x:Bind ViewModel.HoverGeometry.Width, Mode=OneWay}"
                        Height="{x:Bind ViewModel.HoverGeometry.Height, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowHover, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                </Canvas>
                <Canvas
                    x:Name="SelectionOverlay"
                    IsHitTestVisible="False">
                    <Border
                        BorderBrush="#60CDFF"
                        BorderThickness="2"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.X, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.Y, Mode=OneWay}"
                        Width="{x:Bind ViewModel.SelectionGeometry.Width, Mode=OneWay}"
                        Height="{x:Bind ViewModel.SelectionGeometry.Height, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                </Canvas>
                <!-- 编辑态由透明层接管输入，避免组件内容参与命中测试。 -->
                <Border
                    x:Name="EditorInteractionLayer"
                    Background="Transparent"
                    Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                <Canvas
                    x:Name="ResizeOverlay"
                    Background="{x:Null}">
                    <Border
                        x:Name="ResizeTopLeft"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="TopLeft"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.HandleLeft, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.HandleTop, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowResizeHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="左上角调整尺寸">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="#60CDFF" />
                    </Border>
                    <Border
                        x:Name="ResizeTopRight"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="TopRight"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.HandleRight, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.HandleTop, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowResizeHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="右上角调整尺寸">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="#60CDFF" />
                    </Border>
                    <Border
                        x:Name="ResizeBottomLeft"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="BottomLeft"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.HandleLeft, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.HandleBottom, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowResizeHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="左下角调整尺寸">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="#60CDFF" />
                    </Border>
                    <Border
                        x:Name="ResizeBottomRight"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="BottomRight"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.HandleRight, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.HandleBottom, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowResizeHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="右下角调整尺寸">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="#60CDFF" />
                    </Border>
                </Canvas>
            </Grid>
            <Border
                x:Name="HomePanel"
                Style="{StaticResource FloatingPanelStyle}"
                HorizontalAlignment="Left"
                Margin="16,16,0,0"
                Height="207"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HomePanelTransform" />
                </Border.RenderTransform>
                <Border.Resources>
                    <Style x:Key="SceneManagementIconStyle" TargetType="FontIcon">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                </Border.Resources>
                <ContentControl
                    x:Name="HomePanelInput"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="44" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Margin="12,0,0,0">
                            <TextBlock
                                Text="场景"
                                FontWeight="Bold"
                                Height="37"
                                Padding="0,10,0,0" />
                            <Border
                                Style="{StaticResource SectionPillStyle}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                            <Button
                                Style="{StaticResource EditorToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="重新加载场景列表"
                                AutomationProperties.Name="重新加载场景列表"
                                Click="OnRefreshScenesClick">
                                <FontIcon
                                    Style="{StaticResource SceneManagementIconStyle}"
                                    Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                Style="{StaticResource EditorToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="新建场景"
                                AutomationProperties.Name="新建场景"
                                Click="OnCreateSceneClick">
                                <FontIcon
                                    Style="{StaticResource SceneManagementIconStyle}"
                                    Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Style="{StaticResource EditorToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="打开场景文件夹"
                                AutomationProperties.Name="打开场景文件夹"
                                Click="OnOpenFolderClick">
                                <FontIcon
                                    Style="{StaticResource SceneManagementIconStyle}"
                                    Glyph="&#xE838;" />
                            </Button>
                        </StackPanel>
                        <ListView
                            x:Name="SceneList"
                            Grid.Row="1"
                            MinHeight="90"
                            MaxHeight="340"
                            SingleSelectionFollowsFocus="False"
                            ItemsSource="{x:Bind ViewModel.Scenes}"
                            SelectionChanged="OnSceneSelectionChanged"
                            ContainerContentChanging="OnSceneRowContainerChanging">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="MinHeight" Value="40" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SceneListItem">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            MinWidth="0"
                                            Width="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind EnableLabel, Mode=OneWay}"
                                            ToolTipService.ToolTip="设为锁屏场景"
                                            Tapped="OnSceneActionTapped"
                                            Click="OnEnableSceneClick" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{x:Bind ShowActions, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <Button
                                                Style="{StaticResource EditorTransparentIconButtonStyle}"
                                                AllowFocusOnInteraction="True"
                                                ToolTipService.ToolTip="重命名"
                                                AutomationProperties.Name="重命名场景"
                                                Tapped="OnSceneActionTapped"
                                                Click="OnRenameSceneClick">
                                                <FontIcon Style="{StaticResource SceneManagementIconStyle}" Glyph="&#xE8AC;" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource EditorTransparentIconButtonStyle}"
                                                AllowFocusOnInteraction="True"
                                                ToolTipService.ToolTip="复制"
                                                AutomationProperties.Name="复制场景"
                                                Tapped="OnSceneActionTapped"
                                                Click="OnDuplicateSceneClick">
                                                <FontIcon Style="{StaticResource SceneManagementIconStyle}" Glyph="&#xE8C8;" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource EditorTransparentIconButtonStyle}"
                                                AllowFocusOnInteraction="True"
                                                IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                                Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                                                ToolTipService.ToolTip="删除"
                                                AutomationProperties.Name="删除场景"
                                                Tapped="OnSceneActionTapped"
                                                Click="OnDeleteSceneClick">
                                                <FontIcon Style="{StaticResource SceneManagementIconStyle}" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ContentControl>
            </Border>
            <ContentControl
                x:Name="ComponentPanels"
                IsTabStop="False"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="{x:Bind ViewModel.PanelWidth, Mode=OneWay}" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="{x:Bind ViewModel.PanelWidth, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="ComponentLeftPanel"
                        Background="#262626"
                        Padding="8,0,8,0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ComponentLeftTransform" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="8" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="50" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="12,0,0,0">
                                <TextBlock
                                    Text="场景"
                                    FontWeight="Bold"
                                    Height="37"
                                    Padding="0,10,0,0" />
                                <Border
                                    Style="{StaticResource SectionPillStyle}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Style="{StaticResource EditorToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="添加图层"
                                AutomationProperties.Name="添加图层"
                                Click="OnAddLayerClick">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE710;"
                                    FontSize="16" />
                            </Button>
                            <muxc:TreeView
                                x:Name="SceneTree"
                                Grid.Row="1"
                                SelectionMode="Single"
                                AllowDrop="True"
                                CanDragItems="False"
                                ItemsSource="{x:Bind ViewModel.Roots}"
                                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                CanReorderItems="False"
                                PreviewKeyDown="OnTreePreviewKeyDown"
                                ItemInvoked="OnTreeItemInvoked"
                                SelectionChanged="OnTreeSelectionChanged"
                                RightTapped="OnTreeRightTapped">
                                <muxc:TreeView.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:SceneTreeItem">
                                        <muxc:TreeViewItem
                                            ItemsSource="{x:Bind Children}"
                                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                            <Grid
                                                MinHeight="32"
                                                Padding="0,4"
                                                Background="Transparent">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Viewbox
                                                        Width="16"
                                                        Height="16"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center">
                                                        <IconSourceElement
                                                            IconSource="{x:Bind IconSource, Mode=OneWay}" />
                                                    </Viewbox>
                                                    <TextBlock
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </muxc:TreeViewItem>
                                    </DataTemplate>
                                </muxc:TreeView.ItemTemplate>
                            </muxc:TreeView>
                        </Grid>
                        <Grid
                            Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="50" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="12,0,0,0">
                                <TextBlock
                                    Text="组件库"
                                    FontWeight="Bold"
                                    Height="37"
                                    Padding="0,10,0,0" />
                                <Border
                                    Style="{StaticResource SectionPillStyle}" />
                            </StackPanel>
                            <ListView
                                x:Name="ComponentLibrary"
                                Grid.Row="1"
                                CanDragItems="True"
                                IsDoubleTapEnabled="True"
                                SelectionMode="None"
                                ToolTipService.ToolTip="双击添加，或拖到画布和组件树"
                                DragItemsStarting="OnLibraryDragItemsStarting"
                                DragItemsCompleted="OnDragItemsCompleted"
                                DoubleTapped="OnAddComponentDoubleTapped"
                                ItemsSource="{x:Bind ViewModel.Library}">
                                <ListView.ItemContainerStyle>
                                    <Style
                                        TargetType="ListViewItem"
                                        BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter
                                            Property="Padding"
                                            Value="16,0" />
                                        <Setter
                                            Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                        <Setter
                                            Property="MinHeight"
                                            Value="40" />
                                        <Setter
                                            Property="VerticalContentAlignment"
                                            Value="Center" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Viewbox
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center">
                                                <IconSourceElement
                                                    IconSource="{Binding IconSource}" />
                                            </Viewbox>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <Border
                        x:Name="ComponentRightPanel"
                        Grid.Column="2"
                        Background="#262626"
                        Padding="8,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ComponentRightTransform" />
                        </Border.RenderTransform>
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                Spacing="8"
                                Padding="0,0,0,16">
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.InspectorSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="vm:InspectorSection">
                                            <StackPanel
                                                Spacing="8"
                                                Margin="0,0,0,8">
                                                <Grid
                                                    Height="40">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        FontWeight="Bold"
                                                        Margin="12,0,40,0"
                                                        VerticalAlignment="Center" />
                                                    <Border
                                                        Style="{StaticResource EditorSectionPillStyle}"
                                                        Margin="12,0,0,0" />
                                                    <Button
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource EditorToolbarIconButtonStyle}"
                                                        Command="{x:Bind RemoveCommand}"
                                                        ToolTipService.ToolTip="移除特性"
                                                        AutomationProperties.Name="移除特性"
                                                        Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <FontIcon
                                                            Glyph="&#xE711;"
                                                            FontSize="12" />
                                                    </Button>
                                                </Grid>
                                                <ContentControl
                                                    Content="{x:Bind}"
                                                    HorizontalContentAlignment="Stretch"
                                                    ContentTemplateSelector="{StaticResource InspectorEditorTemplateSelector}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    HorizontalAlignment="Stretch">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE710;"
                                            FontSize="16" />
                                        <TextBlock
                                            Text="添加特性" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout
                                            x:Name="AddFeatureFlyout"
                                            Opening="OnAddFeatureMenuOpening" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ContentControl>
            <Border
                x:Name="BackgroundPanel"
                Style="{StaticResource FloatingPanelStyle}"
                HorizontalAlignment="Right"
                Margin="0,16,16,0"
                MinHeight="207"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BackgroundPanelTransform" />
                </Border.RenderTransform>
                <ContentControl
                    x:Name="BackgroundPanelInput"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <StackPanel
                        Spacing="4"
                        VerticalAlignment="Top">
                        <StackPanel
                            Margin="12,0,0,0">
                            <TextBlock
                                Text="背景"
                                FontWeight="Bold"
                                Height="37"
                                Padding="0,10,0,0" />
                            <Border
                                Style="{StaticResource SectionPillStyle}" />
                        </StackPanel>
                        <StackPanel
                            Spacing="8"
                            Margin="12,0,12,8"
                            DataContext="{x:Bind ViewModel.Scene.Background, Mode=OneWay}">
                            <ComboBox
                                Header="背景模式"
                                MinWidth="110"
                                SelectedIndex="{x:Bind ViewModel.Scene.Background.Mode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                                <ComboBoxItem
                                    Content="无" />
                                <ComboBoxItem
                                    Content="视频" />
                            </ComboBox>
                            <ui:BlobPicker
                                x:Name="VideoPicker"
                                BlobId="{x:Bind ViewModel.Scene.Background.BlobId, Mode=TwoWay}"
                                BlobUriConverter="{x:Bind EditorPresenter.BlobUriConverter, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                SuggestedStartLocation="VideosLibrary" />
                            <CheckBox
                                Content="启用声音"
                                IsChecked="{x:Bind ViewModel.Scene.Background.EnableSound, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>
        <muxc:InfoBar
            x:Name="LockScreenReplacementInfoBar"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsOpen="False"
            Severity="Warning"
            Title="未启用替换系统锁屏"
            Message="启用“替换系统锁屏实现”后，OhMyLockScreen 才能接管并显示当前锁屏场景。"
            Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}">
            <muxc:InfoBar.ActionButton>
                <Button
                    Content="前往开启"
                    Click="OnSettingsClick" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>
        <Canvas
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
            <Border
                x:Name="TreeDropIndicator"
                BorderBrush="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                CornerRadius="2"
                Visibility="Collapsed" />
        </Canvas>
        <Popup
            x:Name="TreeDragHintPopup"
            IsHitTestVisible="False">
            <ToolTip
                x:Name="TreeDragHint"
                MaxWidth="280" />
        </Popup>
    </Grid>
</Page>

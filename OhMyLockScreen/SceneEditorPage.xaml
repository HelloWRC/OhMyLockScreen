<Page
    x:Class="OhMyLockScreen.SceneEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:rules="using:OhMyLockScreen.Shared.Controls.Ruleset"
    xmlns:scene="using:OhMyLockScreen.Shared.Controls.Scene"
    xmlns:vm="using:OhMyLockScreen.ViewModels"
    xmlns:components="using:OhMyLockScreen.Shared.Models.Scene"
    xmlns:editor="using:OhMyLockScreen.Controls.Editor"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    xmlns:icons="using:FluentIcons.Uwp"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
    FontFamily="Microsoft YaHei UI">
    <Page.Resources>
        <DataTemplate x:Key="RulesetDrawerTemplate">
            <rules:RulesetControl ShowTitle="True" />
        </DataTemplate>
        <DataTemplate x:Key="LicensePresetMenuItemTemplate">
            <MenuFlyoutItem Text="{Binding}" Click="OnSelectLicensePresetClick" />
        </DataTemplate>
        <Style x:Key="EditorListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- Windows 10 lacks the native single-selection indicator. Use WinUI's cross-version tree row brushes. -->
        <ControlTemplate x:Key="Windows10EditorListItemTemplate" TargetType="ListViewItem">
            <Grid x:Name="Row" Margin="2" Background="{TemplateBinding Background}" CornerRadius="{ThemeResource ControlCornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOverSelected">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PressedSelected">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundDisabled}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundDisabled}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="SelectedDisabled">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedDisabled}" />
                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedDisabled}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="DragStates">
                        <VisualState x:Name="NotDragging" />
                        <VisualState x:Name="Dragging">
                            <VisualState.Setters>
                                <Setter Target="Row.Opacity" Value="{ThemeResource ListViewItemDragThemeOpacity}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter
                    x:Name="Presenter"
                    Padding="{TemplateBinding Padding}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTransitions="{TemplateBinding ContentTransitions}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Foreground="{TemplateBinding Foreground}" />
                <Border
                    Width="3" Height="16" CornerRadius="1.5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}" />
            </Grid>
        </ControlTemplate>
        <DataTemplate x:Key="AddFeatureMenuItemTemplate">
            <MenuFlyoutItem Text="{Binding Name}" Click="OnAddFeatureClick" />
        </DataTemplate>
        <MenuFlyoutItem x:Key="NoAvailableFeaturesMenuItem" Text="没有可添加的特性" IsEnabled="False" />
        <DataTemplate
            x:Key="LayerInspectorTemplate">
            <editor:LayoutPanelSettingsControl
                Model="{Binding Model}" />
        </DataTemplate>
        <DataTemplate
            x:Key="RegisteredInspectorTemplate">
            <ContentControl
                Content="{Binding Editor}"
                HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <editor:InspectorEditorTemplateSelector
            x:Key="InspectorEditorTemplateSelector"
            LayerTemplate="{StaticResource LayerInspectorTemplate}"
            EditorTemplate="{StaticResource RegisteredInspectorTemplate}" />
        <MenuFlyout
            x:Key="TreeContextMenu">
            <MenuFlyoutItem
                Text="重命名"
                Click="OnRenameSelectionClick" />
            <MenuFlyoutItem
                Text="添加图层"
                Click="OnAddLayerClick" />
            <MenuFlyoutItem
                Text="上移"
                Click="OnMoveSelectionUpClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
            <MenuFlyoutItem
                Text="下移"
                Click="OnMoveSelectionDownClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
            <MenuFlyoutItem
                Text="删除"
                Click="OnDeleteSelectionClick"
                Visibility="{Binding CanEditSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
        </MenuFlyout>
        <Style
            x:Key="SectionPillStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="32" />
            <Setter
                Property="Height"
                Value="3" />
            <Setter
                Property="CornerRadius"
                Value="2" />
            <Setter
                Property="Background"
                Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter
                Property="HorizontalAlignment"
                Value="Left" />
        </Style>
        <Style
            x:Key="ResizeHandleStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="24" />
            <Setter
                Property="Height"
                Value="24" />
            <Setter
                Property="Background"
                Value="{ThemeResource SystemControlTransparentBrush}" />
            <Setter
                Property="AllowFocusOnInteraction"
                Value="False" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
        </Style>
        <Style
            x:Key="FloatingPanelStyle"
            TargetType="Border">
            <Setter
                Property="Width"
                Value="325" />
            <Setter
                Property="CornerRadius"
                Value="7" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="8" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
            <Setter
                Property="Background"
                Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>
    <ui:DrawerHost x:Name="EditorDrawer" DrawerPlacement="Right" SizeChanged="OnEditorDrawerSizeChanged">
    <Grid
        x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <!-- 隐藏的 16:9 截图渲染宿主：置于主页面不透明背景层之下，保证布局完整且不裁剪 -->
        <Canvas
            x:Name="CaptureHost"
            Grid.RowSpan="2"
            IsHitTestVisible="False" />
        <Border
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            IsHitTestVisible="False" />
        <ContentDialog
            x:Name="NameDialog"
            Title="{Binding DialogTitle, Mode=OneWay}"
            PrimaryButtonText="确定"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonClick="OnNameDialogPrimaryButtonClick">
            <TextBox
                Text="{Binding DialogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Header="{Binding DialogNameError, Mode=OneWay}"
                MaxLength="120"
                MinWidth="280" />
        </ContentDialog>
        <Grid
            x:Name="TopNavigation"
            Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="场景编辑器"
                FontWeight="Bold"
                Margin="12,0"
                VerticalAlignment="Center" />
            <Pivot
                x:Name="EditorNavigation"
                Grid.Column="1"
                SelectionChanged="OnNavigationChanged"
                SelectedIndex="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource EnumIndexConverter}}"
                HorizontalAlignment="Left"
                Height="48"
                IsHeaderItemsCarouselEnabled="False">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            FontSize="14" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem
                    Header="首页" />
                <PivotItem
                    Header="组件" />
                <PivotItem
                    Header="背景" />
            </Pivot>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Button
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="全屏预览"
                    AutomationProperties.Name="全屏预览"
                    Click="OnPreviewClick">
                    <icons:FluentIcon
                        Icon="Play"
                        FontSize="16" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource EditorToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="设置"
                    AutomationProperties.Name="设置"
                    Click="OnSettingsClick">
                    <icons:FluentIcon
                        Icon="Settings"
                        FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            x:Name="MainContent"
            Grid.Row="1"
            Background="{ThemeResource SystemControlTransparentBrush}"
            SizeChanged="OnContentSizeChanged">
            <Grid
                x:Name="SceneViewport"
                Background="{ThemeResource SystemControlTransparentBrush}"
                AllowDrop="True"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased"
                PointerCanceled="OnCanvasDragCanceled"
                PointerCaptureLost="OnCanvasDragCanceled"
                PointerExited="OnCanvasPointerExited"
                RightTapped="OnCanvasRightTapped"
                DragOver="OnCanvasDragOver"
                Drop="OnCanvasDrop">
                <scene:ScenePresenter
                    x:Name="EditorPresenter"
                    IsEditing="True"
                    IsHitTestVisible="False"
                    ParallaxInputSurface="{x:Bind PageRoot}"
                    Scene="{x:Bind ViewModel.Scene, Mode=OneWay}" />
                <Canvas
                    IsHitTestVisible="False">
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        Canvas.Left="{x:Bind ViewModel.HoverGeometry.X, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.HoverGeometry.Y, Mode=OneWay}"
                        Width="{x:Bind ViewModel.HoverGeometry.Width, Mode=OneWay}"
                        Height="{x:Bind ViewModel.HoverGeometry.Height, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowHover, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                </Canvas>
                <Canvas
                    x:Name="SelectionOverlay"
                    IsHitTestVisible="False">
                    <Polygon
                        x:Name="SelectionOutline"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeThickness="2"
                        StrokeLineJoin="Miter"
                        StrokeMiterLimit="2"
                        Visibility="{x:Bind ViewModel.ShowSelection, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                    <Line
                        X1="{x:Bind ViewModel.SelectionGeometry.RotationStemStartX, Mode=OneWay}"
                        Y1="{x:Bind ViewModel.SelectionGeometry.RotationStemStartY, Mode=OneWay}"
                        X2="{x:Bind ViewModel.SelectionGeometry.RotationHandleCenterX, Mode=OneWay}"
                        Y2="{x:Bind ViewModel.SelectionGeometry.RotationHandleCenterY, Mode=OneWay}"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeThickness="2"
                        Visibility="{x:Bind ViewModel.ShowTransformHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                </Canvas>
                <!-- 编辑态由透明层接管输入，避免组件内容参与命中测试。 -->
                <Border
                    x:Name="EditorInteractionLayer"
                    Background="{ThemeResource SystemControlTransparentBrush}" />
                <Canvas
                    x:Name="ResizeOverlay"
                    AllowFocusOnInteraction="False"
                    Background="{x:Null}">
                    <Border
                        x:Name="ResizeTopLeft"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="TopLeft"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.TopLeftHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.TopLeftHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCornerHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="{x:Bind GetTopLeftHandleName(ViewModel.IsScaleHandleMode), Mode=OneWay}">
                        <Grid IsHitTestVisible="False">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Rectangle
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="ResizeTopRight"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="TopRight"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.TopRightHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.TopRightHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCornerHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="{x:Bind GetTopRightHandleName(ViewModel.IsScaleHandleMode), Mode=OneWay}">
                        <Grid IsHitTestVisible="False">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Rectangle
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="ResizeBottomLeft"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="BottomLeft"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.BottomLeftHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.BottomLeftHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCornerHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="{x:Bind GetBottomLeftHandleName(ViewModel.IsScaleHandleMode), Mode=OneWay}">
                        <Grid IsHitTestVisible="False">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Rectangle
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="ResizeBottomRight"
                        Style="{StaticResource ResizeHandleStyle}"
                        Tag="BottomRight"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.BottomRightHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.BottomRightHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCornerHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnResizePointerPressed"
                        AutomationProperties.Name="{x:Bind GetBottomRightHandleName(ViewModel.IsScaleHandleMode), Mode=OneWay}">
                        <Grid IsHitTestVisible="False">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Rectangle
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsScaleHandleMode, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="RotateHandle"
                        Style="{StaticResource ResizeHandleStyle}"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.RotationHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.RotationHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowTransformHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnRotateHandlePointerPressed"
                        AutomationProperties.Name="旋转把柄">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            IsHitTestVisible="False" />
                    </Border>
                    <Border
                        x:Name="OriginHandle"
                        Style="{StaticResource ResizeHandleStyle}"
                        Canvas.Left="{x:Bind ViewModel.SelectionGeometry.OriginHandleX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SelectionGeometry.OriginHandleY, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowTransformHandles, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        PointerPressed="OnOriginHandlePointerPressed"
                        AutomationProperties.Name="变换中心把柄">
                        <Grid
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                StrokeThickness="2" />
                            <Rectangle
                                Width="12"
                                Height="1.5"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Rectangle
                                Width="1.5"
                                Height="12"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
            <Border
                x:Name="HomePanel"
                Style="{StaticResource FloatingPanelStyle}"
                HorizontalAlignment="Left"
                Margin="16,16,0,0"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HomePanelTransform" />
                </Border.RenderTransform>
                <ContentControl
                    x:Name="HomePanelInput"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="44" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Margin="12,0,0,0">
                            <TextBlock
                                Text="场景信息"
                                FontWeight="Bold"
                                Height="37"
                                Padding="0,10,0,0" />
                            <Border
                                Style="{StaticResource SectionPillStyle}" />
                        </StackPanel>
                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Style="{StaticResource EditorFormStyle}">
                                <TextBlock Text="预览图" />
                                <Border
                                    Height="160"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid CornerRadius="6">
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.58">
                                                    <GradientStop Color="#805ED5D1" Offset="0.008" />
                                                    <GradientStop Color="#803FC3BE" Offset="0.992" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border
                                            x:Name="MetadataPreviewLayer"
                                            CornerRadius="6" />
                                        <TextBlock
                                            Text="未设置预览图"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Visibility="{x:Bind ViewModel.HasPreviewImage, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.IsCapturingPreview, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                        Click="OnCapturePreviewClick"
                                        ToolTipService.ToolTip="按 16:9 截取当前场景画面作为预览图">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:FluentIcon Icon="Camera" FontSize="16" />
                                            <TextBlock Text="16:9 截图" />
                                        </StackPanel>
                                    </Button>
                                    <ui:BlobPicker
                                        x:Name="PreviewImagePicker"
                                        Grid.Column="1"
                                        BlobId="{x:Bind ViewModel.Scene.PreviewImageBlobId, Mode=TwoWay}"
                                        BlobUriConverter="{x:Bind EditorPresenter.BlobUriConverter, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.IsCapturingPreview, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                        SuggestedStartLocation="PicturesLibrary" />
                                </Grid>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Content="清除预览图"
                                    Click="OnClearPreviewClick"
                                    Visibility="{x:Bind ViewModel.HasPreviewImage, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />

                                <TextBox
                                    Header="名称"
                                    MaxLength="120"
                                    Text="{x:Bind ViewModel.MetadataName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    LostFocus="OnMetadataNameLostFocus" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.MetadataNameError, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                                    FontSize="12"
                                    Visibility="{x:Bind ViewModel.HasMetadataNameError, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />

                                <TextBox
                                    Header="描述"
                                    PlaceholderText="介绍此锁屏场景…"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="68"
                                    MaxHeight="120"
                                    MaxLength="500"
                                    Text="{x:Bind ViewModel.Scene.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Header="作者"
                                    PlaceholderText="作者名称"
                                    MaxLength="100"
                                    Text="{x:Bind ViewModel.Scene.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="分发许可"
                                        PlaceholderText="如 CC BY 4.0、MIT…"
                                        MaxLength="120"
                                        Text="{x:Bind ViewModel.Scene.License, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Content="预设"
                                        ToolTipService.ToolTip="选择常用分发许可">
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="LicensePresetFlyout" Opening="OnLicensePresetFlyoutOpening" />
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>
            </Border>
            <ContentControl
                x:Name="ComponentPanels"
                IsTabStop="False"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="{x:Bind ViewModel.PanelWidth, Mode=OneWay}" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="{x:Bind ViewModel.PanelWidth, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="ComponentLeftPanel"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                        Padding="8,0,8,0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ComponentLeftTransform" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="8" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="50" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="12,0,0,0">
                                <TextBlock
                                    Text="场景"
                                    FontWeight="Bold"
                                    Height="37"
                                    Padding="0,10,0,0" />
                                <Border
                                    Style="{StaticResource SectionPillStyle}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Style="{StaticResource EditorToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="添加图层"
                                AutomationProperties.Name="添加图层"
                                Click="OnAddLayerClick">
                                <icons:FluentIcon
                                    Icon="Add"
                                    FontSize="16" />
                            </Button>
                            <muxc:TreeView
                                x:Name="SceneTree"
                                Grid.Row="1"
                                SelectionMode="Single"
                                AllowDrop="True"
                                CanDragItems="False"
                                ItemsSource="{x:Bind ViewModel.Roots}"
                                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                CanReorderItems="False"
                                PreviewKeyDown="OnTreePreviewKeyDown"
                                ItemInvoked="OnTreeItemInvoked"
                                SelectionChanged="OnTreeSelectionChanged"
                                RightTapped="OnTreeRightTapped"
                                PointerExited="OnSceneTreePointerExited">
                                <muxc:TreeView.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:SceneTreeItem">
                                        <muxc:TreeViewItem
                                            ItemsSource="{x:Bind Children}"
                                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                            HorizontalContentAlignment="Stretch"
                                            PointerEntered="OnTreeItemPointerEntered"
                                            PointerExited="OnTreeItemPointerExited"
                                            Unloaded="OnTreeItemUnloaded">
                                            <Grid
                                                MinHeight="32"
                                                Padding="0,2,4,2"
                                                HorizontalAlignment="Stretch"
                                                ColumnSpacing="4"
                                                Background="{ThemeResource SystemControlTransparentBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    ColumnSpacing="8"
                                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox
                                                        Width="16"
                                                        Height="16"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center">
                                                        <IconSourceElement
                                                            IconSource="{x:Bind IconSource, Mode=OneWay}" />
                                                    </Viewbox>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center"
                                                    DoubleTapped="OnTreeActionDoubleTapped"
                                                    Visibility="{x:Bind ShowActionButtons, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}">
                                                    <ToggleButton
                                                        Style="{StaticResource EditorTreeIconToggleButtonStyle}"
                                                        IsChecked="{x:Bind IsLocked, Mode=TwoWay}"
                                                        Visibility="{x:Bind ShowLockButton, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                                                        ToolTipService.ToolTip="{x:Bind LockToolTip, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind LockToolTip, Mode=OneWay}">
                                                        <icons:FluentIcon
                                                            Icon="{x:Bind LockIcon, Mode=OneWay}"
                                                            FontSize="14" />
                                                    </ToggleButton>
                                                    <ToggleButton
                                                        Style="{StaticResource EditorTreeIconToggleButtonStyle}"
                                                        IsChecked="{x:Bind IsHidden, Mode=TwoWay}"
                                                        Opacity="{x:Bind VisibilityButtonOpacity, Mode=OneWay}"
                                                        IsHitTestVisible="{x:Bind IsVisibilityButtonInteractive, Mode=OneWay}"
                                                        IsTabStop="{x:Bind IsVisibilityButtonInteractive, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind VisibilityToolTip, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind VisibilityToolTip, Mode=OneWay}">
                                                        <icons:FluentIcon
                                                            Icon="{x:Bind VisibilityIcon, Mode=OneWay}"
                                                            FontSize="14" />
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Grid>
                                        </muxc:TreeViewItem>
                                    </DataTemplate>
                                </muxc:TreeView.ItemTemplate>
                            </muxc:TreeView>
                        </Grid>
                        <Grid
                            Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="50" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="12,0,0,0">
                                <TextBlock
                                    Text="组件库"
                                    FontWeight="Bold"
                                    Height="37"
                                    Padding="0,10,0,0" />
                                <Border
                                    Style="{StaticResource SectionPillStyle}" />
                            </StackPanel>
                            <ListView
                                x:Name="ComponentLibrary"
                                Grid.Row="1"
                                CanDragItems="True"
                                IsDoubleTapEnabled="True"
                                SelectionMode="None"
                                ToolTipService.ToolTip="双击添加，或拖到画布和组件树"
                                DragItemsStarting="OnLibraryDragItemsStarting"
                                DragItemsCompleted="OnDragItemsCompleted"
                                DoubleTapped="OnAddComponentDoubleTapped"
                                ItemsSource="{x:Bind ViewModel.Library}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource EditorListItemStyle}">
                                        <Setter Property="Padding" Value="16,0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Viewbox
                                                Width="16"
                                                Height="16"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center">
                                                <IconSourceElement
                                                    IconSource="{Binding IconSource}" />
                                            </Viewbox>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <Border
                        x:Name="ComponentRightPanel"
                        Grid.Column="2"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                        Padding="8,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ComponentRightTransform" />
                        </Border.RenderTransform>
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                Spacing="8"
                                Padding="0,0,0,16">
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.InspectorSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="vm:InspectorSection">
                                            <StackPanel
                                                Spacing="8"
                                                Margin="0,0,0,8">
                                                <Grid
                                                    Height="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        FontWeight="Bold"
                                                        Margin="12,0,4,0"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <Border
                                                        Style="{StaticResource EditorSectionPillStyle}"
                                                        Margin="12,0,0,0" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <Button
                                                            Style="{StaticResource EditorToolbarIconButtonStyle}"
                                                            Command="{x:Bind ToggleEnabledCommand}"
                                                            ToolTipService.ToolTip="{x:Bind ToggleEnabledToolTip, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind ToggleEnabledToolTip, Mode=OneWay}">
                                                            <icons:FluentIcon
                                                                Icon="{x:Bind ToggleEnabledIcon, Mode=OneWay}"
                                                                FontSize="14" />
                                                        </Button>
                                                        <Button
                                                            Style="{StaticResource EditorToolbarIconButtonStyle}"
                                                            Command="{x:Bind RemoveCommand}"
                                                            ToolTipService.ToolTip="移除特性"
                                                            AutomationProperties.Name="移除特性">
                                                            <icons:FluentIcon
                                                                Icon="Dismiss"
                                                                FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <ContentControl
                                                    Content="{x:Bind}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Opacity="{x:Bind EditorOpacity, Mode=OneWay}"
                                                    ContentTemplateSelector="{StaticResource InspectorEditorTemplateSelector}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    HorizontalAlignment="Stretch">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <icons:FluentIcon
                                            Icon="Add"
                                            FontSize="16" />
                                        <TextBlock
                                            Text="添加特性" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout
                                            x:Name="AddFeatureFlyout"
                                            Opening="OnAddFeatureMenuOpening" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ContentControl>
            <Border
                x:Name="BackgroundPanel"
                Style="{StaticResource FloatingPanelStyle}"
                HorizontalAlignment="Right"
                Margin="0,16,16,0"
                MinHeight="207"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BackgroundPanelTransform" />
                </Border.RenderTransform>
                <ContentControl
                    x:Name="BackgroundPanelInput"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <StackPanel
                        Spacing="4"
                        VerticalAlignment="Top">
                        <StackPanel
                            Margin="12,0,0,0">
                            <TextBlock
                                Text="背景"
                                FontWeight="Bold"
                                Height="37"
                                Padding="0,10,0,0" />
                            <Border
                                Style="{StaticResource SectionPillStyle}" />
                        </StackPanel>
                        <StackPanel
                            Spacing="8"
                            Margin="12,0,12,8"
                            DataContext="{x:Bind ViewModel.Scene.Background, Mode=OneWay}">
                            <ComboBox
                                Header="背景模式"
                                MinWidth="110"
                                SelectedIndex="{x:Bind ViewModel.Scene.Background.Mode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                                <ComboBoxItem
                                    Content="无" />
                                <ComboBoxItem
                                    Content="视频" />
                                <ComboBoxItem
                                    Content="静态图片" />
                            </ComboBox>
                            <ui:BlobPicker
                                x:Name="VideoPicker"
                                BlobId="{x:Bind ViewModel.Scene.Background.BlobId, Mode=TwoWay}"
                                BlobUriConverter="{x:Bind EditorPresenter.BlobUriConverter, Mode=OneWay}"
                                IsEnabled="{x:Bind CanPickVideo(ViewModel.Scene.Background.Mode), Mode=OneWay}"
                                Visibility="{x:Bind GetVideoControlsVisibility(ViewModel.Scene.Background.Mode), Mode=OneWay}"
                                SuggestedStartLocation="VideosLibrary" />
                            <CheckBox
                                Content="启用声音"
                                IsChecked="{x:Bind ViewModel.Scene.Background.EnableSound, Mode=TwoWay}"
                                Visibility="{x:Bind GetVideoControlsVisibility(ViewModel.Scene.Background.Mode), Mode=OneWay}" />
                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind GetWallpaperControlsVisibility(ViewModel.Scene.Background.Mode), Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind GetWallpaperSourceLabel(ViewModel.Scene.Background.ImageBlobId), Mode=OneWay}" />
                                <ui:BlobPicker
                                    x:Name="WallpaperPicker"
                                    BlobId="{x:Bind ViewModel.Scene.Background.ImageBlobId, Mode=TwoWay}"
                                    BlobUriConverter="{x:Bind EditorPresenter.BlobUriConverter, Mode=OneWay}"
                                    IsEnabled="{x:Bind CanPickWallpaper(ViewModel.Scene.Background.Mode), Mode=OneWay}"
                                    SuggestedStartLocation="PicturesLibrary" />
                                <Button
                                    Click="OnUseSystemWallpaperClick"
                                    Content="使用系统锁屏壁纸"
                                    Visibility="{x:Bind GetSystemWallpaperButtonVisibility(ViewModel.Scene.Background.ImageBlobId), Mode=OneWay}" />
                            </StackPanel>
                            <Slider
                                Header="{x:Bind FormatParallaxStrength(ViewModel.Scene.Background.ParallaxStrength), Mode=OneWay}"
                                Minimum="0"
                                Maximum="200"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.Scene.Background.ParallaxStrength, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>
        <Canvas
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
            <Border
                x:Name="TreeDropIndicator"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="2"
                Visibility="Collapsed" />
        </Canvas>
        <Popup
            x:Name="TreeDragHintPopup"
            IsHitTestVisible="False">
            <ToolTip
                x:Name="TreeDragHint"
                MaxWidth="280" />
        </Popup>
    </Grid>
    </ui:DrawerHost>
</Page>

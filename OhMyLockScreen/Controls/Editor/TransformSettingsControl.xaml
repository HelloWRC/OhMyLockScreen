<local:TransformSettingsControlBase
    x:Class="OhMyLockScreen.Controls.Editor.TransformSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Editor"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:icons="using:FluentIcons.Uwp"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <local:TransformSettingsControlBase.Resources>
        <Style
            x:Key="TransformAxisLabelStyle"
            TargetType="TextBlock">
            <Setter Property="Width" Value="14" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="TransformNumberStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="-100000" />
            <Setter Property="Maximum" Value="100000" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
        </Style>
        <Style
            x:Key="TransformDegreeStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="-36000" />
            <Setter Property="Maximum" Value="36000" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="15" />
        </Style>
        <Style
            x:Key="TransformSkewStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="-89" />
            <Setter Property="Maximum" Value="89" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
        </Style>
        <Style
            x:Key="TransformPercentStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="-100" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.1" />
        </Style>
        <Style
            x:Key="TransformOriginStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="-10" />
            <Setter Property="Maximum" Value="10" />
            <Setter Property="SmallChange" Value="0.05" />
            <Setter Property="LargeChange" Value="0.25" />
        </Style>
        <Style
            x:Key="TransformIconButtonStyle"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <Style
            x:Key="TransformIconToggleButtonStyle"
            TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <Style
            x:Key="OriginAnchorPointStyle"
            TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="8" />
                                            <Setter Target="Dot.Height" Value="8" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="8" />
                                            <Setter Target="Dot.Height" Value="8" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="10" />
                                            <Setter Target="Dot.Height" Value="10" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="Core.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="10" />
                                            <Setter Target="Dot.Height" Value="10" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                            <Setter Target="Core.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="10" />
                                            <Setter Target="Dot.Height" Value="10" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                            <Setter Target="Core.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Dot.Width" Value="10" />
                                            <Setter Target="Dot.Height" Value="10" />
                                            <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                            <Setter Target="Core.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse
                                x:Name="Dot"
                                Width="6"
                                Height="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Ellipse
                                x:Name="Core"
                                Width="4"
                                Height="4"
                                Opacity="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:TransformSettingsControlBase.Resources>

    <StackPanel
        Style="{StaticResource EditorFormStyle}"
        Spacing="12"
        DataContext="{x:Bind Values, Mode=OneWay}">
        <!-- 平移 -->
        <StackPanel Spacing="6">
            <Grid>
                <TextBlock
                    Text="平移"
                    VerticalAlignment="Center" />
                <Button
                    HorizontalAlignment="Right"
                    Width="28"
                    Height="28"
                    Style="{StaticResource EditorTransparentIconButtonStyle}"
                    Command="{x:Bind Values.ResetCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="重置变换"
                    AutomationProperties.Name="重置变换">
                    <icons:FluentIcon
                        Icon="ArrowReset"
                        FontSize="14" />
                </Button>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="X"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="TranslateXInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformNumberStyle}"
                        ToolTipService.ToolTip="水平平移"
                        AutomationProperties.Name="水平平移"
                        Value="{Binding TranslateX, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Y"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="TranslateYInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformNumberStyle}"
                        ToolTipService.ToolTip="竖直平移"
                        AutomationProperties.Name="竖直平移"
                        Value="{Binding TranslateY, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
            </Grid>
        </StackPanel>

        <!-- 旋转与翻转 -->
        <StackPanel Spacing="6">
            <TextBlock Text="旋转" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                        <Canvas
                            Width="16"
                            Height="16">
                            <Path
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeThickness="1.4"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Data="M 13,13 H 3 L 11.5,3.5" />
                            <Path
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeThickness="1.3"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Data="M 7.6,13 C 7.6,11.2 6.8,9.6 5.6,8.5" />
                        </Canvas>
                    </Viewbox>
                    <muxc:NumberBox
                        x:Name="RotationInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformDegreeStyle}"
                        ToolTipService.ToolTip="旋转角度"
                        AutomationProperties.Name="旋转角度"
                        Value="{Binding Rotation, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Style="{StaticResource TransformIconButtonStyle}"
                        Command="{x:Bind Values.Rotate90Command, Mode=OneWay}"
                        ToolTipService.ToolTip="顺时针旋转 90°"
                        AutomationProperties.Name="顺时针旋转 90°">
                        <icons:FluentIcon
                            Icon="ArrowRotateClockwise"
                            FontSize="16" />
                    </Button>
                    <ToggleButton
                        Grid.Column="1"
                        Style="{StaticResource TransformIconToggleButtonStyle}"
                        IsChecked="{Binding FlipHorizontal, Mode=TwoWay}"
                        ToolTipService.ToolTip="水平翻转"
                        AutomationProperties.Name="水平翻转">
                        <icons:FluentIcon
                            Icon="FlipHorizontal"
                            FontSize="16" />
                    </ToggleButton>
                    <ToggleButton
                        Grid.Column="2"
                        Style="{StaticResource TransformIconToggleButtonStyle}"
                        IsChecked="{Binding FlipVertical, Mode=TwoWay}"
                        ToolTipService.ToolTip="垂直翻转"
                        AutomationProperties.Name="垂直翻转">
                        <icons:FluentIcon
                            Icon="FlipVertical"
                            FontSize="16" />
                    </ToggleButton>
                </Grid>
            </Grid>
        </StackPanel>

        <!-- 缩放 -->
        <StackPanel Spacing="6">
            <TextBlock Text="缩放" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="X"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="ScaleXInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformPercentStyle}"
                        ToolTipService.ToolTip="水平缩放"
                        AutomationProperties.Name="水平缩放"
                        Value="{Binding ScaleX, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Y"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="ScaleYInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformPercentStyle}"
                        ToolTipService.ToolTip="竖直缩放"
                        AutomationProperties.Name="竖直缩放"
                        Value="{Binding ScaleY, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
                <ToggleButton
                    Grid.Column="2"
                    Width="32"
                    Style="{StaticResource TransformIconToggleButtonStyle}"
                    IsChecked="{Binding IsScaleLocked, Mode=TwoWay}"
                    ToolTipService.ToolTip="等比锁定"
                    AutomationProperties.Name="等比锁定">
                    <icons:FluentIcon
                        Icon="Link"
                        FontSize="16" />
                </ToggleButton>
            </Grid>
        </StackPanel>

        <!-- 斜切 -->
        <StackPanel Spacing="6">
            <TextBlock Text="斜切" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="X"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="SkewXInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformSkewStyle}"
                        ToolTipService.ToolTip="水平斜切"
                        AutomationProperties.Name="水平斜切"
                        Value="{Binding SkewX, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Y"
                        Style="{StaticResource TransformAxisLabelStyle}" />
                    <muxc:NumberBox
                        x:Name="SkewYInput"
                        Grid.Column="1"
                        Style="{StaticResource TransformSkewStyle}"
                        ToolTipService.ToolTip="竖直斜切"
                        AutomationProperties.Name="竖直斜切"
                        Value="{Binding SkewY, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                </Grid>
            </Grid>
        </StackPanel>

        <Rectangle
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 变换中心 -->
        <StackPanel Spacing="6">
            <TextBlock Text="变换中心" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="68"
                    Height="68"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Border
                            Margin="11"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                        <Rectangle
                            Height="1"
                            Margin="11,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                            IsHitTestVisible="False" />
                        <Rectangle
                            Width="1"
                            Margin="0,11"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                            IsHitTestVisible="False" />
                        <Grid Padding="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsTopLeft, Mode=TwoWay}"
                                ToolTipService.ToolTip="左上角"
                                AutomationProperties.Name="左上角" />
                            <ToggleButton
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsTopCenter, Mode=TwoWay}"
                                ToolTipService.ToolTip="顶部居中"
                                AutomationProperties.Name="顶部居中" />
                            <ToggleButton
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsTopRight, Mode=TwoWay}"
                                ToolTipService.ToolTip="右上角"
                                AutomationProperties.Name="右上角" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsMiddleLeft, Mode=TwoWay}"
                                ToolTipService.ToolTip="左侧居中"
                                AutomationProperties.Name="左侧居中" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsCenter, Mode=TwoWay}"
                                ToolTipService.ToolTip="中心"
                                AutomationProperties.Name="中心" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsMiddleRight, Mode=TwoWay}"
                                ToolTipService.ToolTip="右侧居中"
                                AutomationProperties.Name="右侧居中" />
                            <ToggleButton
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsBottomLeft, Mode=TwoWay}"
                                ToolTipService.ToolTip="左下角"
                                AutomationProperties.Name="左下角" />
                            <ToggleButton
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsBottomCenter, Mode=TwoWay}"
                                ToolTipService.ToolTip="底部居中"
                                AutomationProperties.Name="底部居中" />
                            <ToggleButton
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource OriginAnchorPointStyle}"
                                IsChecked="{Binding IsBottomRight, Mode=TwoWay}"
                                ToolTipService.ToolTip="右下角"
                                AutomationProperties.Name="右下角" />
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="X"
                            Style="{StaticResource TransformAxisLabelStyle}" />
                        <muxc:NumberBox
                            x:Name="OriginXInput"
                            Grid.Column="1"
                            Style="{StaticResource TransformOriginStyle}"
                            ToolTipService.ToolTip="水平变换中心"
                            AutomationProperties.Name="水平变换中心"
                            Value="{Binding OriginX, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Y"
                            Style="{StaticResource TransformAxisLabelStyle}" />
                        <muxc:NumberBox
                            x:Name="OriginYInput"
                            Grid.Column="1"
                            Style="{StaticResource TransformOriginStyle}"
                            ToolTipService.ToolTip="竖直变换中心"
                            AutomationProperties.Name="竖直变换中心"
                            Value="{Binding OriginY, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</local:TransformSettingsControlBase>

<local:OpacitySettingsControlBase
    x:Class="OhMyLockScreen.Controls.Editor.OpacitySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Editor"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:icons="using:FluentIcons.Uwp"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <local:OpacitySettingsControlBase.Resources>
        <Style
            x:Key="OpacityNumberStyle"
            TargetType="muxc:NumberBox"
            BasedOn="{StaticResource EditorNumberStyle}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="Width" Value="116" />
        </Style>
    </local:OpacitySettingsControlBase.Resources>

    <StackPanel
        Style="{StaticResource EditorFormStyle}"
        Spacing="12"
        DataContext="{x:Bind Values, Mode=OneWay}">
        <!-- 不透明度与重置 -->
        <StackPanel Spacing="4">
            <Grid>
                <TextBlock
                    Text="不透明度"
                    VerticalAlignment="Center" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <muxc:NumberBox
                        x:Name="OpacityInput"
                        Style="{StaticResource OpacityNumberStyle}"
                        ToolTipService.ToolTip="不透明度"
                        AutomationProperties.Name="不透明度"
                        Value="{Binding Opacity, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                    <Button
                        x:Name="ResetButton"
                        Width="28"
                        Height="28"
                        Style="{StaticResource EditorTransparentIconButtonStyle}"
                        Command="{x:Bind Values.ResetCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="重置不透明度"
                        AutomationProperties.Name="重置不透明度">
                        <icons:FluentIcon
                            Icon="ArrowReset"
                            FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
            <Slider
                x:Name="OpacitySlider"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                Value="{Binding OpacityPercent, Mode=TwoWay}"
                ToolTipService.ToolTip="不透明度"
                AutomationProperties.Name="不透明度滑块" />
        </StackPanel>

        <!-- 混合方式 -->
        <ComboBox
            x:Name="BlendModeComboBox"
            Header="混合方式"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind BlendModes}"
            DisplayMemberPath="Name"
            SelectedIndex="{Binding BlendModeIndex, Mode=TwoWay}"
            AutomationProperties.Name="混合方式" />
    </StackPanel>
</local:OpacitySettingsControlBase>

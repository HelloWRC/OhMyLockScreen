<local:ThemeSettingsControlBase
    x:Class="OhMyLockScreen.Controls.Editor.ThemeSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Editor">
    <StackPanel Style="{StaticResource EditorFormStyle}">
        <ComboBox
            Header="颜色主题"
            HorizontalAlignment="Stretch"
            SelectedIndex="{x:Bind Settings.RequestedTheme, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
            <ComboBoxItem Content="默认" />
            <ComboBoxItem Content="浅色" />
            <ComboBoxItem Content="深色" />
        </ComboBox>
    </StackPanel>
</local:ThemeSettingsControlBase>

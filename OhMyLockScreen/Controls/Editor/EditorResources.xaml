<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:OhMyLockScreen.Controls.Editor">
    <local:FiniteNumberConverter
        x:Key="FiniteNumberConverter" />
    <local:EnumIndexConverter
        x:Key="EnumIndexConverter" />
    <local:InverseBooleanConverter
        x:Key="InverseBooleanConverter" />
    <local:BooleanVisibilityConverter
        x:Key="BooleanVisibilityConverter" />
    <Style
        x:Key="EditorFormStyle"
        TargetType="StackPanel">
        <Setter
            Property="Spacing"
            Value="8" />
        <Setter
            Property="Margin"
            Value="12,2,12,8" />
    </Style>
    <Style
        x:Key="EditorNumberStyle"
        TargetType="muxc:NumberBox">
        <Setter
            Property="Minimum"
            Value="0" />
        <Setter
            Property="Maximum"
            Value="100000" />
        <Setter
            Property="SmallChange"
            Value="1" />
        <Setter
            Property="SpinButtonPlacementMode"
            Value="Compact" />
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
        <Setter
            Property="MinWidth"
            Value="48" />
    </Style>
    <Style
        x:Key="EditorSectionPillStyle"
        TargetType="Border">
        <Setter
            Property="Width"
            Value="32" />
        <Setter
            Property="Height"
            Value="3" />
        <Setter
            Property="CornerRadius"
            Value="2" />
        <Setter
            Property="Background"
            Value="#60CDFF" />
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
        <Setter
            Property="VerticalAlignment"
            Value="Bottom" />
    </Style>
    <Style
        x:Key="EditorTransparentButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource TextBlockButtonStyle}">
        <Setter
            Property="MinWidth"
            Value="0" />
        <Setter
            Property="MinHeight"
            Value="0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="BorderThickness"
            Value="0" />
        <Setter
            Property="BorderBrush"
            Value="Transparent" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="CornerRadius"
            Value="4" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Center" />
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="AllowFocusOnInteraction"
            Value="False" />
        <Setter
            Property="UseSystemFocusVisuals"
            Value="True" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        GeneratedDuration="0:0:0.167">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase
                                                EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState
                                    x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="HoverBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="PressedBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="ScaleRoot.Opacity"
                                            Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="HoverBase.Opacity"
                                            Value="1" />
                                        <Setter
                                            Target="PressedBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="ScaleRoot.Opacity"
                                            Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="HoverBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="PressedBase.Opacity"
                                            Value="1" />
                                        <Setter
                                            Target="ScaleRoot.Opacity"
                                            Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            To="0.98"
                                            Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            To="0.98"
                                            Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="HoverBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="PressedBase.Opacity"
                                            Value="0" />
                                        <Setter
                                            Target="ScaleRoot.Opacity"
                                            Value="0.4" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            To="1"
                                            Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase
                                                    EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid
                            x:Name="ScaleRoot"
                            Background="Transparent"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <CompositeTransform />
                            </Grid.RenderTransform>
                            <Border
                                x:Name="ButtonBase"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3" />
                            <Border
                                x:Name="HoverBase"
                                Margin="{TemplateBinding Padding}"
                                Background="{ThemeResource ButtonBackgroundPointerOver}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PressedBase"
                                Margin="{TemplateBinding Padding}"
                                Background="{ThemeResource ButtonBackgroundPressed}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="EditorTransparentIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource EditorTransparentButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style
        x:Key="EditorToolbarIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource EditorTransparentIconButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="5" />
    </Style>
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    xmlns:local="using:OhMyLockScreen.Controls.Editor">
    <local:FiniteNumberConverter
        x:Key="FiniteNumberConverter" />
    <local:EnumIndexConverter
        x:Key="EnumIndexConverter" />
    <local:InverseBooleanConverter
        x:Key="InverseBooleanConverter" />
    <local:BooleanVisibilityConverter
        x:Key="BooleanVisibilityConverter" />
    <Style
        x:Key="EditorFormStyle"
        TargetType="StackPanel">
        <Setter
            Property="Spacing"
            Value="8" />
        <Setter
            Property="Margin"
            Value="12,2,12,8" />
    </Style>
    <Style
        x:Key="EditorNumberStyle"
        TargetType="muxc:NumberBox">
        <Setter
            Property="ui:NumberBoxBehavior.HideClearButton"
            Value="True" />
        <Setter
            Property="Minimum"
            Value="0" />
        <Setter
            Property="Maximum"
            Value="100000" />
        <Setter
            Property="SmallChange"
            Value="1" />
        <Setter
            Property="SpinButtonPlacementMode"
            Value="Compact" />
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
        <Setter
            Property="MinWidth"
            Value="48" />
    </Style>
    <Style
        x:Key="EditorSectionPillStyle"
        TargetType="Border">
        <Setter
            Property="Width"
            Value="32" />
        <Setter
            Property="Height"
            Value="3" />
        <Setter
            Property="CornerRadius"
            Value="2" />
        <Setter
            Property="Background"
            Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
        <Setter
            Property="VerticalAlignment"
            Value="Bottom" />
    </Style>
    <Style
        x:Key="EditorTransparentIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource TransparentButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
    </Style>
    <Style
        x:Key="EditorToolbarIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource EditorTransparentIconButtonStyle}">
        <Setter Property="Margin" Value="4" />
    </Style>
</ResourceDictionary>

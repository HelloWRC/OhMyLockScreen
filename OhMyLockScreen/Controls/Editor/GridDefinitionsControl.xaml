<UserControl
    x:Class="OhMyLockScreen.Controls.Editor.GridDefinitionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:scene="using:OhMyLockScreen.Shared.Models.Scene">
    <StackPanel
        Spacing="4">
        <Grid>
            <TextBlock
                Text="{x:Bind Header, Mode=OneWay}"
                VerticalAlignment="Center" />
            <Button
                Style="{StaticResource EditorTransparentIconButtonStyle}"
                HorizontalAlignment="Right"
                Click="OnAddClick"
                AutomationProperties.Name="添加网格定义">
                <FontIcon
                    Glyph="&#xE710;"
                    FontSize="16" />
            </Button>
        </Grid>
        <ItemsControl
            ItemsSource="{x:Bind Definitions, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate
                    x:DataType="scene:GridElement">
                    <Grid
                        ColumnSpacing="4"
                        Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{Binding Mode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                            <ComboBoxItem
                                Content="比例" />
                            <ComboBoxItem
                                Content="固定" />
                            <ComboBoxItem
                                Content="自动" />
                        </ComboBox>
                        <muxc:NumberBox
                            Grid.Column="1"
                            Style="{StaticResource EditorNumberStyle}"
                            Value="{Binding Value, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource EditorTransparentIconButtonStyle}"
                            Click="OnRemoveClick"
                            AutomationProperties.Name="移除网格定义">
                            <FontIcon
                                Glyph="&#xE738;"
                                FontSize="12" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

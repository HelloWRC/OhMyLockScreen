<local:ClockSettingsControlBase
    x:Class="OhMyLockScreen.Controls.Components.ClockSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:OhMyLockScreen.Controls.Components">
    <StackPanel
        Spacing="4"
        Margin="12,2,12,0">
        <CheckBox
            Content="显示秒数"
            IsChecked="{x:Bind Settings.ShowSeconds, Mode=TwoWay}" />
        <CheckBox
            Content="分隔符闪烁"
            IsChecked="{x:Bind Settings.FlashSeparator, Mode=TwoWay}" />
        <muxc:NumberBox
            Header="字号"
            Minimum="1"
            Maximum="512"
            Style="{StaticResource EditorNumberStyle}"
            Value="{Binding FontSize, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}" />
    </StackPanel>
</local:ClockSettingsControlBase>

<local:ClockComponentBase
    x:Class="OhMyLockScreen.Controls.Components.ClockComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Components"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <!-- 拆分为独立 TextBlock 并通过 Opacity 控制分隔符显隐，避免替换字符导致任意字体宽度抖动，同时兼容 AcrylicBrush 前景。 -->
    <StackPanel
        x:Name="PartsPanel"
        Orientation="Horizontal"
        HorizontalAlignment="{x:Bind ToHorizontalAlignment(TextContent.TextAlignment), Mode=OneWay}">
        <TextBlock
            x:Name="TextContent"
            Visibility="{x:Bind Settings.ShowHours, Mode=OneWay}"
            Text="{x:Bind HoursText, Mode=OneWay}" />
        <TextBlock
            x:Name="MinuteSeparator"
            Visibility="{x:Bind Settings.ShowMinuteSeparator, Mode=OneWay}"
            Text=":"
            Opacity="{x:Bind SeparatorOpacity, Mode=OneWay}"
            LineHeight="{x:Bind TextContent.LineHeight, Mode=OneWay}"
            LineStackingStrategy="{x:Bind TextContent.LineStackingStrategy, Mode=OneWay}"
            TextDecorations="{x:Bind TextContent.TextDecorations, Mode=OneWay}" />
        <TextBlock
            x:Name="MinutesContent"
            Visibility="{x:Bind Settings.ShowMinutes, Mode=OneWay}"
            Text="{x:Bind MinutesText, Mode=OneWay}"
            LineHeight="{x:Bind TextContent.LineHeight, Mode=OneWay}"
            LineStackingStrategy="{x:Bind TextContent.LineStackingStrategy, Mode=OneWay}"
            TextDecorations="{x:Bind TextContent.TextDecorations, Mode=OneWay}" />
        <TextBlock
            x:Name="SecondSeparator"
            Text=":"
            Opacity="{x:Bind SeparatorOpacity, Mode=OneWay}"
            Visibility="{x:Bind Settings.ShowSecondSeparator, Mode=OneWay}"
            LineHeight="{x:Bind TextContent.LineHeight, Mode=OneWay}"
            LineStackingStrategy="{x:Bind TextContent.LineStackingStrategy, Mode=OneWay}"
            TextDecorations="{x:Bind TextContent.TextDecorations, Mode=OneWay}" />
        <TextBlock
            x:Name="SecondsContent"
            Text="{x:Bind SecondsText, Mode=OneWay}"
            Visibility="{x:Bind SecondsVisibility, Mode=OneWay}"
            LineHeight="{x:Bind TextContent.LineHeight, Mode=OneWay}"
            LineStackingStrategy="{x:Bind TextContent.LineStackingStrategy, Mode=OneWay}"
            TextDecorations="{x:Bind TextContent.TextDecorations, Mode=OneWay}" />
    </StackPanel>
</local:ClockComponentBase>

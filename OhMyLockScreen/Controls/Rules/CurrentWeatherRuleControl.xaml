<local:CurrentWeatherRuleControlBase
    x:Class="OhMyLockScreen.Controls.Rules.CurrentWeatherRuleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Rules">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <ComboBox ItemsSource="{x:Bind Choices}" SelectedValuePath="Code"
                  SelectedValue="{x:Bind Settings.WeatherId, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:WeatherRuleChoice">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Viewbox Height="16" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                            <ContentControl Content="{x:Bind IconContent}" ContentTemplate="{x:Bind IconTemplate}"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Loaded="OnIconLoaded" />
                        </Viewbox>
                        <TextBlock Text="{x:Bind Name}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="模糊匹配" MinWidth="0" IsChecked="{x:Bind Settings.IsFuzzyMatch, Mode=TwoWay}" />
    </StackPanel>
</local:CurrentWeatherRuleControlBase>

<local:MediaFieldRuleControlBase
    x:Class="OhMyLockScreen.Controls.Rules.MediaFieldRuleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OhMyLockScreen.Controls.Rules">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <ComboBox ItemsSource="{x:Bind FieldNames}"
                  SelectedIndex="{x:Bind GetFieldIndex(Settings.Field), Mode=TwoWay, BindBack=SetFieldIndex}" />
        <CheckBox Content="正则" MinWidth="0" IsChecked="{x:Bind Settings.UseRegex, Mode=TwoWay}" />
        <TextBox Width="140" Text="{x:Bind Settings.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</local:MediaFieldRuleControlBase>

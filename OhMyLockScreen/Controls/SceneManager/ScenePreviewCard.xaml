<UserControl
    x:Class="OhMyLockScreen.Controls.SceneManager.ScenePreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:icons="using:FluentIcons.Uwp"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    mc:Ignorable="d"
    Width="356"
    Height="200"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="{x:Bind Item.ActiveAutomationName, Mode=OneWay}"
    KeyDown="OnCardKeyDown">
    <UserControl.Resources>
        <MenuFlyout
            x:Key="CardOptionsFlyout"
            Opening="OnOptionsFlyoutOpening">
            <MenuFlyoutItem
                x:Name="SetActiveMenuItem"
                Text="设为锁屏"
                Click="OnSetActiveClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="SelectAllOn" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="编辑…"
                Click="OnEditClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="Edit" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="预览"
                Click="OnPreviewClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="Play" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="导出"
                Click="OnExportClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="ArrowExport" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="复制"
                Click="OnDuplicateClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="CopyAdd" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="打开文件夹…"
                Click="OnOpenFolderClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="FolderOpen" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Text="重命名"
                Click="OnRenameClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="Rename" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="DeleteMenuItem"
                Text="删除"
                Click="OnDeleteClick">
                <MenuFlyoutItem.Icon>
                    <icons:FluentIcon Icon="Delete" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>
    <Grid
        x:Name="CardRoot"
        CornerRadius="8"
        PointerEntered="OnCardPointerEntered"
        PointerExited="OnCardPointerExited"
        PointerPressed="OnCardPointerPressed"
        PointerReleased="OnCardPointerReleased"
        PointerCanceled="OnCardPointerCanceled"
        PointerCaptureLost="OnCardPointerCanceled"
        Tapped="OnCardTapped"
        RightTapped="OnCardRightTapped">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="HoverOverlay.Opacity" Value="0.6" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="OutlineBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="OutlineBorder.BorderThickness" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 默认渐变底色（与 Figma 占位一致） -->
        <Border CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.58">
                    <GradientStop Color="#805ED5D1" Offset="0.008" />
                    <GradientStop Color="#803FC3BE" Offset="0.992" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 预览图 -->
        <Border
            x:Name="PreviewImageLayer"
            CornerRadius="8"
            IsHitTestVisible="False" />

        <!-- 悬停态轻量高亮 -->
        <Border
            x:Name="HoverOverlay"
            CornerRadius="8"
            Background="#14FFFFFF"
            Opacity="0"
            IsHitTestVisible="False" />

        <!-- 底部信息叠层：固定深色前景色确保浅色壁纸下也可读 -->
        <Grid
            VerticalAlignment="Bottom"
            RequestedTheme="Dark">
            <Border
                CornerRadius="0,0,8,8"
                IsHitTestVisible="False">
                <Border.Background>
                    <ui:MaskedBackdropBlurBrush
                        BlurAmount="16"
                        TintColor="#A3000000" />
                </Border.Background>
            </Border>
            <Grid
                Padding="10,12,4,6"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Item.Name, Mode=OneWay}"
                        FontSize="13"
                        LineHeight="16"
                        Foreground="White"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        x:Name="DescriptionTextBlock"
                        Text="{x:Bind Item.Description, Mode=OneWay}"
                        FontSize="10"
                        LineHeight="13"
                        Foreground="#BFFFFFFF"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind Item.HasDescription, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>

                <Button
                    x:Name="MoreButton"
                    Grid.Column="1"
                    Style="{StaticResource EditorTransparentIconButtonStyle}"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Foreground="White"
                    ToolTipService.ToolTip="更多操作"
                    AutomationProperties.Name="场景操作菜单"
                    Tapped="OnMoreButtonTapped"
                    Click="OnMoreButtonClick">
                    <icons:FluentIcon
                        Icon="MoreHorizontal"
                        FontSize="16" />
                </Button>
            </Grid>
        </Grid>

        <!-- 边框叠层：保持内部布局尺寸在未选中/选中态之间不抖动 -->
        <Border
            x:Name="OutlineBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>

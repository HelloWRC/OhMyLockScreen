<Project>
  <PropertyGroup>
    <_NativeHostProject>$(MSBuildThisFileDirectory)OhMyLockScreen.NativeHost.csproj</_NativeHostProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(_NativeHostProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="IncludeNativeHostPublishFiles"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(_NativeHostProject)"
             Targets="GetNativeHostPublishItems"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             RemoveProperties="PublishProfile;PublishSelfContained;PublishDir;OutDir;OutputPath;PublishProtocol;NoBuild;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeHostPublishItem" />
    </MSBuild>

    <ItemGroup>
      <_HostPublishItemNormalized Include="@(ResolvedFileToPublish)">
        <_NormalizedRelativePath>$([System.String]::Copy('%(RelativePath)').Replace('/', '\'))</_NormalizedRelativePath>
        <_NormalizedFullPath>$([System.IO.Path]::GetFullPath('%(FullPath)'))</_NormalizedFullPath>
      </_HostPublishItemNormalized>
      <_NativeHostPublishItemNormalized Include="@(_NativeHostPublishItem)">
        <_NormalizedRelativePath>$([System.String]::Copy('%(RelativePath)').Replace('/', '\'))</_NormalizedRelativePath>
        <_NormalizedFullPath>$([System.IO.Path]::GetFullPath('%(FullPath)'))</_NormalizedFullPath>
      </_NativeHostPublishItemNormalized>

      <!-- Only package files not already provided by the host project so runtime and shared NuGet assemblies are shared. -->
      <_NativeHostUniquePublishItem Include="@(_NativeHostPublishItemNormalized)" />
      <_NativeHostUniquePublishItem Remove="@(_HostPublishItemNormalized)"
                                    MatchOnMetadata="_NormalizedRelativePath"
                                    MatchOnMetadataOptions="CaseInsensitive" />

      <!-- Fail fast if a shared runtime or NuGet assembly resolves to a different source/version than the host project. -->
      <_NativeHostSharedPublishItem Include="@(_NativeHostPublishItemNormalized)" />
      <_NativeHostSharedPublishItem Remove="@(_NativeHostUniquePublishItem)"
                                    MatchOnMetadata="_NormalizedRelativePath"
                                    MatchOnMetadataOptions="CaseInsensitive" />
      <_NativeHostConflictingSharedItem Include="@(_NativeHostSharedPublishItem)" />
      <_NativeHostConflictingSharedItem Remove="@(_HostPublishItemNormalized)"
                                        MatchOnMetadata="_NormalizedRelativePath;_NormalizedFullPath"
                                        MatchOnMetadataOptions="CaseInsensitive" />
    </ItemGroup>

    <Error Condition="'@(_NativeHostConflictingSharedItem)' != ''"
           Text="NativeHost shared runtime/dependency file conflict detected (version or source differs from host project): @(_NativeHostConflictingSharedItem->'%(_NormalizedRelativePath) (%(_NormalizedFullPath))', ', ')" />

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NativeHostUniquePublishItem)">
        <RelativePath>%(_NativeHostUniquePublishItem._NormalizedRelativePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyNativeHostToOutputDirectory"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ComputeFilesToPublish;IncludeNativeHostPublishFiles"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_NativeHostUniquePublishItem)"
          DestinationFiles="@(_NativeHostUniquePublishItem->'$(OutDir)%(_NormalizedRelativePath)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="$(OverwriteReadOnlyFiles)"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
</Project>

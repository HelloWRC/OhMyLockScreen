<UserControl x:Class="OhMyLockScreen.Shared.Controls.Ruleset.RuleSegment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <Storyboard x:Name="FirstTransition">
            <DoubleAnimation x:Name="FirstWidthAnimation" Storyboard.TargetName="FirstViewport" Storyboard.TargetProperty="Width"
                             EnableDependentAnimation="True" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation x:Name="FirstOpacityAnimation" Storyboard.TargetName="FirstText" Storyboard.TargetProperty="Opacity" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SecondTransition">
            <DoubleAnimation x:Name="SecondWidthAnimation" Storyboard.TargetName="SecondViewport" Storyboard.TargetProperty="Width"
                             EnableDependentAnimation="True" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation x:Name="SecondOpacityAnimation" Storyboard.TargetName="SecondText" Storyboard.TargetProperty="Opacity" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <toolkit:Segmented x:Name="Selector" HorizontalAlignment="Left" SelectionMode="Single"
                       SelectionChanged="OnSelectionChanged">
        <toolkit:Segmented.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </toolkit:Segmented.ItemsPanel>
        <toolkit:SegmentedItem x:Name="FirstItem" MinWidth="0" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon x:Name="FirstIcon" FontSize="14" />
                <Canvas x:Name="FirstViewport" Width="0" Height="20" SizeChanged="OnViewportSizeChanged">
                    <Canvas.Clip><RectangleGeometry /></Canvas.Clip>
                    <TextBlock x:Name="FirstText" Canvas.Left="4" TextWrapping="NoWrap" />
                </Canvas>
            </StackPanel>
        </toolkit:SegmentedItem>
        <toolkit:SegmentedItem x:Name="SecondItem" MinWidth="0" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon x:Name="SecondIcon" FontSize="14" />
                <Canvas x:Name="SecondViewport" Width="0" Height="20" SizeChanged="OnViewportSizeChanged">
                    <Canvas.Clip><RectangleGeometry /></Canvas.Clip>
                    <TextBlock x:Name="SecondText" Canvas.Left="4" TextWrapping="NoWrap" />
                </Canvas>
            </StackPanel>
        </toolkit:SegmentedItem>
    </toolkit:Segmented>
</UserControl>

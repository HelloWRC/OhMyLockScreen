<ContentPresenter
    x:Class="OhMyLockScreen.Shared.Controls.Scene.ComponentPresenter"
    x:Name="RootPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <ContentPresenter.ContentTemplate>
        <DataTemplate>
            <ui:ChainedDecorator
                Chain="{Binding Decorators, ElementName=RootPresenter, Mode=OneWay}">
                <ContentPresenter
                    Content="{Binding Content, ElementName=RootPresenter, Mode=OneWay}"
                    Foreground="{Binding ContentForeground, ElementName=RootPresenter, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </ui:ChainedDecorator>
        </DataTemplate>
    </ContentPresenter.ContentTemplate>
</ContentPresenter>

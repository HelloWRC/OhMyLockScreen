<ContentPresenter
    x:Class="OhMyLockScreen.Shared.Controls.Scene.ComponentPresenter"
    x:Name="RootPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <ContentPresenter.ContentTemplate>
        <DataTemplate>
            <Grid x:Name="StripeHost">
                <Grid x:Name="OriginalContent">
                    <Border
                        Loaded="OnDecorationBorderLoaded"
                        Unloaded="OnDecorationBorderUnloaded">
                        <ContentPresenter
                            Content="{Binding Content, ElementName=RootPresenter, Mode=OneWay}"
                            Foreground="{Binding ContentForeground, ElementName=RootPresenter, Mode=OneWay}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </ContentPresenter.ContentTemplate>
</ContentPresenter>

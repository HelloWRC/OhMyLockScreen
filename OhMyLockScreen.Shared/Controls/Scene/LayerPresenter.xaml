<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:scene="using:OhMyLockScreen.Shared.Controls.Scene"
    xmlns:ui="using:OhMyLockScreen.Shared.Controls.UI">
    <Style TargetType="scene:LayerPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="scene:LayerPresenter">
                    <ui:ShadowDecorator
                        ShadowSpec="{Binding Path=(ui:ShadowEffect.Shadow), Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        RenderTransform="{Binding ParallaxTransform, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        RenderTransformOrigin="0.5,0.5">
                        <Border Background="{TemplateBinding Background}">
                            <scene:LayoutControl
                                BlobUriConverter="{TemplateBinding BlobUriConverter}"
                                IsEditing="{TemplateBinding IsEditing}"
                                Settings="{Binding Layer, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                ItemsSource="{Binding Layer.Children, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </Border>
                    </ui:ShadowDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

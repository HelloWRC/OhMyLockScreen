<ItemsControl
    x:Class="OhMyLockScreen.Shared.Controls.Scene.LayoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:scene="using:OhMyLockScreen.Shared.Controls.Scene"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ItemsControl.Resources>
        <DataTemplate x:Key="ComponentContainerTemplate">
            <scene:ComponentPresenter />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="CanvasItemsPanel">
            <scene:AutoSizedCanvas />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelItemsPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelItemsPanel">
            <toolkit:WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridItemsPanel">
            <scene:AutoSizedGrid />
        </ItemsPanelTemplate>
    </ItemsControl.Resources>
</ItemsControl>

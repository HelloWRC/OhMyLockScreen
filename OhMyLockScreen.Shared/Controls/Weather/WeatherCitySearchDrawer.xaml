<UserControl
    x:Class="OhMyLockScreen.Shared.Controls.Weather.WeatherCitySearchDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OhMyLockScreen.Shared.Models.Weather"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Width="320"
    Margin="16">
    <UserControl.Resources>
        <Style x:Key="CityRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="CityRadioListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid
                            x:Name="ContentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundPressed}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundSelected}" />
                                            <Setter Target="RadioIndicator.IsChecked" Value="True" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPointerOver}" />
                                            <Setter Target="RadioIndicator.IsChecked" Value="True" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}" />
                                            <Setter Target="RadioIndicator.IsChecked" Value="True" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource ListViewItemBackgroundSelected}" />
                                            <Setter Target="ContentBorder.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                            <Setter Target="RadioIndicator.IsChecked" Value="True" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <RadioButton
                                x:Name="RadioIndicator"
                                Style="{StaticResource CityRadioButtonStyle}"
                                IsChecked="False"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="搜索城市" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid>
                <TextBox
                    x:Name="SearchText"
                    PlaceholderText="搜索城市或省份…"
                    AutomationProperties.Name="搜索城市或省份"
                    TextChanged="OnSearchTextChanged" />
                <muxc:ProgressRing
                    x:Name="SearchProgress"
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
        </StackPanel>
        <ListView
            x:Name="Cities"
            Grid.Row="1"
            Margin="0,8,0,0"
            SelectionMode="Single"
            SingleSelectionFollowsFocus="False"
            ShowsScrollingPlaceholders="False"
            AutomationProperties.Name="城市列表"
            ItemContainerStyle="{StaticResource CityRadioListViewItemStyle}"
            SelectionChanged="OnCitySelected">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WeatherCity">
                    <TextBlock
                        Text="{x:Bind Name}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" Margin="0,50" Spacing="8" Visibility="Collapsed">
            <ContentControl x:Name="EmptyIcon" HorizontalAlignment="Center" />
            <TextBlock Text="找不到符合条件的城市。请更换搜索关键字，然后再试一次。" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

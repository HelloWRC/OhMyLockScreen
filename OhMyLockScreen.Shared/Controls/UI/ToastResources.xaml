<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <AcrylicBrush x:Key="InfoBarInformationalSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#282828" TintOpacity="0.8" FallbackColor="#282828" />
            <AcrylicBrush x:Key="InfoBarSuccessSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#393D1B" TintOpacity="0.8" FallbackColor="#393D1B" />
            <AcrylicBrush x:Key="InfoBarWarningSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#433519" TintOpacity="0.8" FallbackColor="#433519" />
            <AcrylicBrush x:Key="InfoBarErrorSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#442726" TintOpacity="0.8" FallbackColor="#442726" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <AcrylicBrush x:Key="InfoBarInformationalSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#F4F4F4" TintOpacity="0.8" FallbackColor="#F4F4F4" />
            <AcrylicBrush x:Key="InfoBarSuccessSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#DFF6DD" TintOpacity="0.8" FallbackColor="#DFF6DD" />
            <AcrylicBrush x:Key="InfoBarWarningSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#FFF4CE" TintOpacity="0.8" FallbackColor="#FFF4CE" />
            <AcrylicBrush x:Key="InfoBarErrorSeverityBackgroundBrush"
                          BackgroundSource="Backdrop" TintColor="#FDE7E9" TintOpacity="0.8" FallbackColor="#FDE7E9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

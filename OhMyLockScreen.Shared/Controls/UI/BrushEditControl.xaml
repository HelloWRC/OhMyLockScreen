<UserControl
    x:Class="OhMyLockScreen.Shared.Controls.UI.BrushEditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:OhMyLockScreen.Shared.Controls.UI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:icons="using:FluentIcons.Uwp"
    xmlns:numbers="using:Windows.Globalization.NumberFormatting"
    mc:Ignorable="d"
    d:DesignWidth="325"
    MinWidth="325"
    HorizontalContentAlignment="Stretch"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    GotFocus="OnFocusChanged"
    LostFocus="OnFocusChanged">
    <UserControl.Resources>
        <Style x:Key="BrushEditorHandleStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border Margin="4" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <numbers:PercentFormatter x:Key="PercentageFormatter" FractionDigits="0" />
        <Style x:Key="PercentageNumberStyle" TargetType="muxc:NumberBox">
            <Setter Property="local:NumberBoxBehavior.HideClearButton" Value="True" />
            <Setter Property="Width" Value="124" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="EditorPanel" Padding="8">
        <toolkit:Segmented
            x:Name="TypeSelector"
            Margin="0,4"
            HorizontalAlignment="Stretch"
            SelectionMode="Single"
            SelectionChanged="OnTypeChanged"
            AutomationProperties.Name="笔刷类型">
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="空" AutomationProperties.Name="空">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="ColorOff" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="纯色" AutomationProperties.Name="纯色">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="Color" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="线性渐变" AutomationProperties.Name="线性渐变">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="ColorLine" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="径向渐变" AutomationProperties.Name="径向渐变">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="CircleMultipleConcentric" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="图片" AutomationProperties.Name="图片">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="Image" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem MinWidth="0" Padding="8,4" ToolTipService.ToolTip="亚克力" AutomationProperties.Name="亚克力">
                <toolkit:SegmentedItem.Icon>
                    <icons:FluentIcon Icon="CircleHalfFill" FontSize="20" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
        </toolkit:Segmented>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Pivot
            x:Name="AcrylicColorSelector"
            Height="48"
            Visibility="Collapsed"
            SelectedIndex="0"
            HorizontalAlignment="Left"
            IsHeaderItemsCarouselEnabled="False"
            SelectionChanged="OnAcrylicColorChanged"
            AutomationProperties.Name="亚克力颜色类型">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        FontSize="14" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
            <PivotItem Header="色调颜色" />
            <PivotItem Header="回退颜色" />
        </Pivot>
        <muxc:ColorPicker
            x:Name="Picker"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            MinWidth="0"
            IsAlphaEnabled="True"
            IsAlphaSliderVisible="False"
            IsAlphaTextInputVisible="False"
            IsMoreButtonVisible="False"
            ColorSpectrumShape="Box"
            ColorSpectrumComponents="HueSaturation"
            ColorChanged="OnColorChanged"
            AutomationProperties.Name="笔刷颜色" />
        <StackPanel x:Name="GradientPanel" Visibility="Collapsed" Spacing="8">
            <Grid x:Name="StopStrip" Height="32" Tapped="OnStopStripTapped" DoubleTapped="OnStopStripDoubleTapped" SizeChanged="OnStopStripSizeChanged"
                  ToolTipService.ToolTip="双击添加色标；拖动或使用方向键调整，Delete 删除">
                <Border x:Name="StopTrack" Height="12" Margin="10,0" CornerRadius="6" VerticalAlignment="Center" />
                <Canvas x:Name="StopHandles" Background="Transparent" />
            </Grid>
            <Grid>
                <Button x:Name="ReverseButton" Width="40" Height="32" Padding="8" Background="Transparent" BorderThickness="0"
                        Click="OnReverseClick" ToolTipService.ToolTip="反转渐变" AutomationProperties.Name="反转渐变">
                    <icons:FluentIcon Icon="ArrowSync" FontSize="16" />
                </Button>
                <muxc:NumberBox x:Name="OffsetInput" HorizontalAlignment="Right"
                                Style="{StaticResource PercentageNumberStyle}" ValueChanged="OnOffsetChanged"
                                AutomationProperties.Name="当前色标位置" />
            </Grid>
        </StackPanel>
        <StackPanel x:Name="ImagePanel" Visibility="Collapsed" Spacing="8">
            <Grid x:Name="ImagePreview" Height="174" SizeChanged="OnImagePreviewSizeChanged" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <TextBlock x:Name="EmptyImageText" Text="请选择图片" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Rectangle x:Name="ImagePreviewSurface" />
            </Grid>
            <Grid>
                <TextBlock Text="填充模式" VerticalAlignment="Center" />
                <ComboBox x:Name="StretchSelector" Width="124" HorizontalAlignment="Right"
                          SelectionChanged="OnStretchChanged" AutomationProperties.Name="填充模式">
                    <ComboBoxItem Content="无" />
                    <ComboBoxItem Content="填充" />
                    <ComboBoxItem Content="等比适应" />
                    <ComboBoxItem Content="等比填充" />
                </ComboBox>
            </Grid>
            <local:BlobPicker
                x:Name="ImagePicker"
                BlobId="{x:Bind ImageBlobId, Mode=TwoWay}"
                BlobUriConverter="{x:Bind BlobUriConverter, Mode=OneWay}"
                SuggestedStartLocation="PicturesLibrary" />
        </StackPanel>
        <CheckBox x:Name="FallbackCheckBox" Visibility="Collapsed" Content="始终使用回退颜色"
                  Checked="OnFallbackChanged" Unchecked="OnFallbackChanged" MinHeight="32" />
        <Grid x:Name="TintOpacityRow" Visibility="Collapsed">
            <TextBlock Text="色调不透明度" VerticalAlignment="Center" />
            <muxc:NumberBox x:Name="TintOpacityInput" HorizontalAlignment="Right"
                            Style="{StaticResource PercentageNumberStyle}" ValueChanged="OnTintOpacityChanged"
                            AutomationProperties.Name="色调不透明度" />
        </Grid>
        <Grid x:Name="OpacityRow" Visibility="Collapsed">
            <TextBlock Text="画刷不透明度" VerticalAlignment="Center" />
            <muxc:NumberBox x:Name="OpacityInput" HorizontalAlignment="Right"
                            Style="{StaticResource PercentageNumberStyle}" ValueChanged="OnOpacityChanged"
                            AutomationProperties.Name="画刷不透明度" />
        </Grid>
    </StackPanel>
</UserControl>
